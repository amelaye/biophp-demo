{% macro render_value(value) %}
    {%- if value is iterable -%}
        <ul class="mb-0">
        {%- for key, item in value -%}
            <li><strong>{{ key }}</strong> : {{ _self.render_value(item) }}</li>
        {%- endfor -%}
        </ul>
    {%- elseif value is same as(true) -%}
        {{ 'value.yes'|trans }}
    {%- elseif value is same as(false) -%}
        {{ 'value.no'|trans }}
    {%- elseif value is null or value == '' -%}
        <em class="text-muted">{{ 'value.none'|trans }}</em>
    {%- else -%}
        {{ value }}
    {%- endif -%}
{% endmacro %}

{% macro sequence_row(seq) %}
    <tr>
        <td>{{ seq.getPrimAcc() }}</td>
        <td>{{ seq.getEntryName() }}</td>
        <td>{{ seq.getSeqLength() }}</td>
        <td>{{ seq.getMolType() }}</td>
        <td><pre class="mb-0" style="white-space: pre-wrap; word-break: break-all;">{{ seq.getSequence() }}</pre></td>
    </tr>
{% endmacro %}

{% macro sequence_set_table(seqSet) %}
    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>{{ 'doc.common.primary_accession'|trans }}</th>
                <th>{{ 'doc.common.entry_name'|trans }}</th>
                <th>{{ 'doc.common.length'|trans }}</th>
                <th>{{ 'doc.common.mol_type'|trans }}</th>
                <th>{{ 'doc.common.sequence'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for seq in seqSet %}
            {{ _self.sequence_row(seq) }}
        {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{% macro sequence_details(seq) %}
    <table class="table table-sm">
        <tr><th>{{ 'doc.common.primary_accession'|trans }}</th><td>{{ seq.getPrimAcc() }}</td></tr>
        <tr><th>{{ 'doc.common.entry_name'|trans }}</th><td>{{ seq.getEntryName() }}</td></tr>
        <tr><th>{{ 'doc.common.length'|trans }}</th><td>{{ seq.getSeqLength() }}</td></tr>
        <tr><th>{{ 'doc.common.start_end'|trans }}</th><td>{{ seq.getStart() }} / {{ seq.getEnd() }}</td></tr>
        <tr><th>{{ 'doc.common.molecule_type'|trans }}</th><td>{{ seq.getMolType() }}</td></tr>
        <tr><th>{{ 'doc.common.date'|trans }}</th><td>{{ seq.getDate() }}</td></tr>
        <tr><th>{{ 'doc.common.source'|trans }}</th><td>{{ seq.getSource() }}</td></tr>
        <tr><th>{{ 'doc.common.description'|trans }}</th><td>{{ seq.getDescription() }}</td></tr>
        <tr><th>{{ 'doc.common.organism'|trans }}</th><td>{{ _self.render_value(seq.getOrganism()) }}</td></tr>
        <tr><th>{{ 'doc.common.fragment'|trans }}</th><td>{{ seq.getFragment() }}</td></tr>
        <tr>
            <th>{{ 'doc.common.sequence'|trans }}</th>
            <td><pre class="mb-0" style="white-space: pre-wrap; word-break: break-all;">{{ seq.getSequence() }}</pre></td>
        </tr>
    </table>
{% endmacro %}
