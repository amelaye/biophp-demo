{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'flask' %}
{% set page_title    = 'Protein sequence information' %}
{% set has_result    = results %}

{% block intro %}
    <p>
        Protein sequence information and derived properties: aminoacid composition, molecular
        weight, molar absorption coefficient, isoelectric point and charge at a given pH.
    </p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.seq) }}

            <div class="bp-form__pair">
                {{ form_row(form.start) }}
                {{ form_row(form.end) }}
            </div>
            <p class="bp-form__help">(both included) for computation</p>
        </div>

        <div class="bp-form__col">
            {{ form_row(form.composition) }}
            {{ form_row(form.molweight) }}
            {{ form_row(form.abscoef) }}

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.charge) }}
                    {{ form_label(form.charge) }}
                </div>
                {{ form_widget(form.data_source) }}
            </div>

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.charge2) }}
                    {{ form_label(form.charge2) }}
                </div>
                {{ form_widget(form.pH) }}
            </div>

            {{ form_row(form.three_letters) }}
            {{ form_row(form.type1) }}
            {{ form_row(form.type2) }}
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}Results of your request{% endblock %}

{% block result %}
    <h5>Subsequence used for calculations</h5>
    <pre>{{ subsequence | chunk_split(70) }}</pre>

    {% if aminoacids is not empty %}
        <h5>Aminoacid composition of protein</h5>
        <div class="bp-tablewrap">
            <table>
                <thead>
                    <tr><th>1 letter</th><th>3 letters</th><th>count</th></tr>
                </thead>
                <tbody>
                    {% for amino in aminoacids %}
                        <tr>
                            <td>{{ amino.one_letter }}</td>
                            <td>{{ amino.three_letters }}</td>
                            <td>{{ amino.count }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if three_letter_code != "" %}
        <h5>Sequence as three letters aminoacid code</h5>
        <pre>{{ three_letter_code }}</pre>
    {% endif %}

    {% if colored_seq is not empty %}
        <h5>
            <span style="color: {{ colors.polar }}">Polar</span>,
            <span style="color: {{ colors.nonpolar }}">Nonpolar</span> or
            <span style="color: {{ colors.charged }}">Charged</span> aminoacids
        </h5>
        <div class="bp-seq">
            {% for seq in colored_seq %}<span style="color:{{ seq.1 }}">{{ seq.0 }}</span>{% endfor %}
        </div>
    {% endif %}

    {% if colored_seq2 is not empty %}
        <h5>
            <span style="color: {{ colors.polar }}">Polar</span>,
            <span style="color: {{ colors.nonpolar }}">small non-polar</span>,
            <span style="color: {{ colors.hydrophobic }}">hydrophobic</span>,
            <span style="color: {{ colors.negatively_charged }}">negatively</span> or
            <span style="color: {{ colors.positively_charged }}">positively</span> charged aminoacids
        </h5>
        <div class="bp-seq">
            {% for seq in colored_seq2 %}<span style="color:{{ seq.1 }}">{{ seq.0 }}</span>{% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block result_aside %}
    <div class="bp-panel">
        <h3 class="bp-panel__title">Informations</h3>
        <dl class="bp-facts">
            {% if molweight != 0 %}
                <dt>Molecular weight</dt><dd>{{ molweight }} Daltons</dd>
            {% endif %}
            {% if abscoef != 0 %}
                <dt>Molar Absorption Coefficient at 280 nm</dt><dd>{{ abscoef | round(2) }}</dd>
            {% endif %}
            {% if charge != 0 %}
                <dt>Isoelectric point of sequence ({{ data_source }})</dt><dd>{{ charge | round(2) }}</dd>
            {% endif %}
            {% if charge2 != 0 %}
                <dt>Charge of sequence at pH = {{ pH }} ({{ data_source }})</dt><dd>{{ charge2 | round(2) }}</dd>
            {% endif %}
        </dl>
    </div>
{% endblock %}

{% block description_lead %}Protein sequence information tool{% endblock %}

{% block description %}
    <h5>Notes</h5>
    <p>
        Non-coding characters will be removed by default.<br />
        <a href="http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?cmd=retrieve&amp;db=pubmed&amp;list_uids=7957164&amp;dopt=abstract"
           target="_blank" rel="noopener">NC-UIBMB</a> codes are used as a reference.
    </p>

    <h5>Computation</h5>
    <p>Molecular Weight:</p>
    <pre>MW =(A*71.07)+(R*156.18)+(nN*114.08)+(nD*115.08)+(nC*103.10)
+(nQ*128.13)+(nE*129.11)+(nG*57.05)+(nH*137.14)+(nI*113.15)+
+(nL*113.15)+(nK*128.17)+(nM*131.19)+(nF*147.17)+(nP*97.11)+
+(nS*87.07)+(nT*101.10)+(nW*186.20)+(nY*163.17)+(nV*99.13)+18.02</pre>
    <p>
        Molar absorption coefficient:
        <a href="http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?cmd=Retrieve&amp;db=pubmed&amp;dopt=Abstract&amp;list_uids=8563639"
           target="_blank" rel="noopener">Pace et al., 1995</a>
    </p>
    <p>
        Isoelectric point estimation:
        <a href="http://fields.scripps.edu/DTASelect/20010710-pI-Algorithm.pdf"
           target="_blank" rel="noopener">Tabb D., 2003</a>
    </p>

    <h5>Type of aminoacid (1)</h5>
    <ul>
        <li>Polar: SCTNQHYW</li>
        <li>Non-Polar: GAPVILFM</li>
        <li>Charged: DEKR</li>
    </ul>

    <h5>Type of aminoacid (2)</h5>
    <ul>
        <li>Small non-polar: SCTNQHYW (Yellow)</li>
        <li>Hydrophobic: CVILPFYMW (Green)</li>
        <li>Polar: DQH (Magenta)</li>
        <li>Negatively charged: NE (Red)</li>
        <li>Positively charged: KR (Blue)</li>
    </ul>
{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>Text taken from <cite title="Source Title">biophp.org</cite>.</span>
    </p>
{% endblock %}
