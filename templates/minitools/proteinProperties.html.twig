{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'flask' %}
{% set page_title    = 'tool.protein_properties.page_title'|trans %}
{% set has_result    = results %}

{% block intro %}
    <p>{{ 'tool.protein_properties.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.seq) }}

            <div class="bp-form__pair">
                {{ form_row(form.start) }}
                {{ form_row(form.end) }}
            </div>
            <p class="bp-form__help">{{ 'tool.protein_properties.both_included_for_computation'|trans }}</p>
        </div>

        <div class="bp-form__col">
            {{ form_row(form.composition) }}
            {{ form_row(form.molweight) }}
            {{ form_row(form.abscoef) }}

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.charge) }}
                    {{ form_label(form.charge) }}
                </div>
                {{ form_widget(form.data_source) }}
            </div>

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.charge2) }}
                    {{ form_label(form.charge2) }}
                </div>
                {{ form_widget(form.pH) }}
            </div>

            {{ form_row(form.three_letters) }}
            {{ form_row(form.type1) }}
            {{ form_row(form.type2) }}
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <h5>{{ 'tool.protein_properties.subsequence_used_for_calculations'|trans }}</h5>
    <pre>{{ subsequence | chunk_split(70) }}</pre>

    {% if aminoacids is not empty %}
        <h5>{{ 'tool.protein_properties.aminoacid_composition_of_protein'|trans }}</h5>
        <div class="bp-tablewrap">
            <table>
                <thead>
                    <tr><th>{{ 'tool.protein_properties.1_letter'|trans }}</th><th>{{ 'tool.protein_properties.3_letters'|trans }}</th><th>{{ 'tool.protein_properties.count'|trans }}</th></tr>
                </thead>
                <tbody>
                    {% for amino in aminoacids %}
                        <tr>
                            <td>{{ amino.one_letter }}</td>
                            <td>{{ amino.three_letters }}</td>
                            <td>{{ amino.count }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if three_letter_code != "" %}
        <h5>{{ 'tool.protein_properties.sequence_as_three_letters_aminoacid_code'|trans }}</h5>
        <pre>{{ three_letter_code }}</pre>
    {% endif %}

    {% if colored_seq is not empty %}
        {# chaque famille est un fragment coloré injecté dans la phrase traduite,
           pour que le français puisse en changer l'ordre #}
        {% set c_polar    = '<span style="color: ' ~ colors.polar    ~ '">' ~ 'tool.protein_properties.polar'|trans    ~ '</span>' %}
        {% set c_nonpolar = '<span style="color: ' ~ colors.nonpolar ~ '">' ~ 'tool.protein_properties.nonpolar'|trans ~ '</span>' %}
        {% set c_charged  = '<span style="color: ' ~ colors.charged  ~ '">' ~ 'tool.protein_properties.charged'|trans  ~ '</span>' %}
        <h5>{{ 'tool.protein_properties.legend_type1'|trans({
            '%polar%': c_polar, '%nonpolar%': c_nonpolar, '%charged%': c_charged
        })|raw }}</h5>
        <div class="bp-seq">
            {% for seq in colored_seq %}<span style="color:{{ seq.1 }}">{{ seq.0 }}</span>{% endfor %}
        </div>
    {% endif %}

    {% if colored_seq2 is not empty %}
        {% set c_polar  = '<span style="color: ' ~ colors.polar               ~ '">' ~ 'tool.protein_properties.polar'|trans          ~ '</span>' %}
        {% set c_small  = '<span style="color: ' ~ colors.nonpolar            ~ '">' ~ 'tool.protein_properties.small_nonpolar'|trans ~ '</span>' %}
        {% set c_hydro  = '<span style="color: ' ~ colors.hydrophobic         ~ '">' ~ 'tool.protein_properties.hydrophobic'|trans    ~ '</span>' %}
        {% set c_neg    = '<span style="color: ' ~ colors.negatively_charged  ~ '">' ~ 'tool.protein_properties.negatively'|trans     ~ '</span>' %}
        {% set c_pos    = '<span style="color: ' ~ colors.positively_charged  ~ '">' ~ 'tool.protein_properties.positively'|trans     ~ '</span>' %}
        <h5>{{ 'tool.protein_properties.legend_type2'|trans({
            '%polar%': c_polar, '%small_nonpolar%': c_small, '%hydrophobic%': c_hydro,
            '%negatively%': c_neg, '%positively%': c_pos
        })|raw }}</h5>
        <div class="bp-seq">
            {% for seq in colored_seq2 %}<span style="color:{{ seq.1 }}">{{ seq.0 }}</span>{% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block result_aside %}
    <div class="bp-panel">
        <h3 class="bp-panel__title">{{ 'panel.informations'|trans }}</h3>
        <dl class="bp-facts">
            {% if molweight != 0 %}
                <dt>{{ 'tool.protein_properties.molecular_weight'|trans }}</dt><dd>{{ 'tool.protein_properties.daltons'|trans({'%value%': molweight}) }}</dd>
            {% endif %}
            {% if abscoef != 0 %}
                <dt>{{ 'tool.protein_properties.molar_absorption_coefficient_at_280_nm'|trans }}</dt><dd>{{ abscoef | round(2) }}</dd>
            {% endif %}
            {% if charge != 0 %}
                <dt>{{ 'tool.protein_properties.isoelectric_point'|trans({'%source%': data_source}) }}</dt><dd>{{ charge | round(2) }}</dd>
            {% endif %}
            {% if charge2 != 0 %}
                <dt>{{ 'tool.protein_properties.charge_at_ph'|trans({'%ph%': pH, '%source%': data_source}) }}</dt><dd>{{ charge2 | round(2) }}</dd>
            {% endif %}
        </dl>
    </div>
{% endblock %}

{% block description_lead %}{{ 'tool.protein_properties.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/proteinProperties.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/proteinProperties.en.html.twig'
]) }}{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>{{ 'note.biophp_credit'|trans({'%source%': '<cite title="Source Title">biophp.org</cite>'})|raw }}</span>
    </p>
{% endblock %}
