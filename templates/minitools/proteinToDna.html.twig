{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'protein' %}
{% set page_title    = 'tool.protein_to_dna.page_title'|trans %}
{% set page_subtitle = 'tool.protein_to_dna.page_subtitle'|trans %}
{% set has_result    = sequence != "" %}

{% block intro %}
    <p>{{ 'tool.protein_to_dna.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form bp-form--single'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.sequence) }}
            {{ form_row(form.genetic_code) }}
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <h5>{{ 'tool.protein_to_dna.input_sequence'|trans }}</h5>
    <pre>{{ sequence|chunk_split(20, '<br>') }}</pre>

    <h5>{{ 'tool.protein_to_dna.reverse_translated_sequence'|trans }}</h5>
    <pre>{{ dna|chunk_split(60, '<br>')|atgc_sublimer('red') }}</pre>
{% endblock %}

{# cet outil n'a pas de texte de description dans la version d'origine #}
{% block description_step %}{% endblock %}
