{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'protein' %}
{% set page_title    = 'Protein to DNA' %}
{% set page_subtitle = 'Reverse translation' %}
{% set has_result    = sequence != "" %}

{% block intro %}
    <p>
        Reverse-translate a protein sequence into the DNA sequence that encodes it, using one
        of the predefined genetic codes.
    </p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form bp-form--single'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.sequence) }}
            {{ form_row(form.genetic_code) }}
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}Results of your request{% endblock %}

{% block result %}
    <h5>Input sequence</h5>
    <pre>{{ sequence|chunk_split(20, '<br>') }}</pre>

    <h5>Reverse Translated sequence</h5>
    <pre>{{ dna|chunk_split(60, '<br>')|atgc_sublimer('red') }}</pre>
{% endblock %}

{# cet outil n'a pas de texte de description dans la version d'origine #}
{% block description_step %}{% endblock %}
