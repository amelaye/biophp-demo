{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'grid' %}
{% set page_title    = 'tool.chaos_game_representation_fcgr.page_title'|trans %}
{% set page_subtitle = 'tool.chaos_game_representation_fcgr.page_subtitle'|trans %}
{% set has_result    = oligos is not null %}

{% block intro %}
    <p>{{ 'tool.chaos_game_representation_fcgr.intro'|trans|raw }}</p>
{% endblock %}

{% block form_lead %}{{ 'tool.chaos_game_representation_fcgr.form_lead'|trans }}{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_row(form.seq) }}
            {{ form_row(form.seq_name) }}
        </div>

        <div class="bp-form__col">
            <div class="bp-form__pair">
                {{ form_row(form.len) }}
                {{ form_row(form.s) }}
            </div>
            {{ form_row(form.map) }}
            {{ form_row(form.freq) }}
            {{ form_row(form.submit) }}
        </div>

        {% do form.size.setRendered %}
        {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}

{% block description_lead %}{{ 'tool.chaos_game_representation_fcgr.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/chaosGameRepresentationFCGR.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/chaosGameRepresentationFCGR.en.html.twig'
]) }}{% endblock %}

{% block result %}
    <div class="bp-figure">
        {% if is_map == 1 %}
            <map name="fcgr-map">
                {% for seq, area in areas %}
                    <area class="mapseq" data-toggle="tooltip" data-placement="top"
                          title="{{ seq }} => {{ oligos[seq] }}"
                          coords="{{ area.0 }}, {{ area.1 }}, {{ area.2 }}, {{ area.3 }}"
                          shape="rect" alt="{{ seq }}" />
                {% endfor %}
            </map>
            <img usemap="#fcgr-map" src="/created_files/{{ image }}" alt="FCGR image of the sequence" />
        {% else %}
            <img src="/created_files/{{ image }}" alt="FCGR image of the sequence" />
        {% endif %}
    </div>

    {% if show_as_freq == 1 %}
        <p>{{ 'tool.chaos_game_representation_fcgr.raw_data'|trans }}</p>
        <div class="bp-tablewrap">
            <table>
                <thead>
                    <tr><th style="width:200px">{{ 'tool.chaos_game_representation_fcgr.sequence'|trans }}</th><th>{{ 'tool.chaos_game_representation_fcgr.occurences'|trans }}</th></tr>
                </thead>
                <tbody>
                    {% for oligo, freq in oligos %}
                        <tr><td>{{ oligo }}</td><td>{{ freq }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}

{% block result_aside %}
    <div class="bp-panel">
        <h3 class="bp-panel__title">{{ 'panel.informations'|trans }}</h3>
        <dl class="bp-facts">
            <dt>{{ 'tool.chaos_game_representation_fcgr.oligos'|trans }}</dt><dd>{{ oligos|length }}</dd>
            <dt>{{ 'tool.chaos_game_representation_fcgr.bases'|trans }}</dt><dd>A, C, G, T</dd>
            <dt>{{ 'tool.chaos_game_representation_fcgr.image_map'|trans }}</dt><dd>{{ is_map == 1 ? 'on' : 'off' }}</dd>
        </dl>
    </div>

    <div class="bp-panel">
        <h3 class="bp-panel__title">{{ 'panel.export'|trans }}</h3>
        <a class="bp-download" href="/created_files/{{ image }}" download>
            <svg aria-hidden="true"><use href="#bp-i-download"></use></svg>
            <span>{{ 'action.download_image'|trans }}</span>
        </a>
    </div>
{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>{{ 'note.insilico'|trans|raw }}</span>
    </p>
{% endblock %}

{% block js_scripts %}
    $(function () {
        $('[data-toggle="tooltip"]').tooltip()
    });
{% endblock %}
