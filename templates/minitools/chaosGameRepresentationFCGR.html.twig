{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'grid' %}
{% set page_title    = 'FCGR' %}
{% set page_subtitle = 'Chaos Game Representation of Frequencies' %}
{% set has_result    = oligos is not null %}

{% block intro %}
    <p>
        Graphical representation of genomes and oligonucleotide frequencies. Each base
        (A, C, G, T) is mapped to a corner of a square and points are plotted iteratively,
        revealing the fractal patterns that are characteristic of the analysed sequence.
    </p>
{% endblock %}

{% block form_lead %}Saisissez la séquence à représenter et réglez la taille de l'image.{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_row(form.seq) }}
            {{ form_row(form.seq_name) }}
        </div>

        <div class="bp-form__col">
            <div class="bp-form__pair">
                {{ form_row(form.len) }}
                {{ form_row(form.s) }}
            </div>
            {{ form_row(form.map) }}
            {{ form_row(form.freq) }}
            {{ form_row(form.submit) }}
        </div>

        {% do form.size.setRendered %}
        {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}

{% block description_lead %}Chaos Game Representation of Frequencies (FCGR){% endblock %}

{% block description %}
    <div class="bp-split">
        <div>
            <p>
                The chaos game maps each nucleotide to a corner of a square: A (adenine) top left,
                C (cytosine) bottom left, G (guanine) top right and T (thymine) bottom right.
                Starting from the centre, every base of the sequence moves the current point halfway
                towards the matching corner, and that new position is plotted. After many iterations,
                fractal patterns emerge that are characteristic of the sequence.
            </p>
            <p>
                The FCGR variant, as described by
                <a href="http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?cmd=Retrieve&amp;db=pubmed&amp;dopt=Abstract&amp;list_uids=10563018"
                   target="_blank" rel="noopener">Deschavanne <i>at al</i>.</a> (1999),
                represents frequencies of oligonucleotides rather than successive positions.
            </p>
        </div>

        <div class="bp-figure">
            {# les quatre sommets, et les deux premiers demi-pas pour la séquence « GA » #}
            <svg viewBox="0 0 300 230" width="300" height="230" role="img"
                 aria-label="Square with A top left, C bottom left, G top right and T bottom right; starting
                             from the centre, each base moves the point halfway towards its corner.">
                <rect x="74" y="46" width="150" height="150" rx="3"
                      fill="rgba(139,92,246,.06)" stroke="#8b5cf6" stroke-opacity=".45"/>

                {# demi-pas : centre -> vers G, puis -> vers A #}
                <line x1="149" y1="121" x2="186.5" y2="83.5" stroke="#fbbf24" stroke-opacity=".65"
                      stroke-width="1.4" stroke-dasharray="4 3"/>
                <line x1="186.5" y1="83.5" x2="130.25" y2="64.75" stroke="#4ade80" stroke-opacity=".65"
                      stroke-width="1.4" stroke-dasharray="4 3"/>

                <circle cx="149" cy="121" r="3.4" fill="#ece9ff"/>
                <text x="139" y="137" font-size="10" fill="#a79fd4">start</text>
                <circle cx="186.5" cy="83.5" r="3" fill="#fbbf24"/>
                <circle cx="130.25" cy="64.75" r="3" fill="#4ade80"/>

                {# sommets #}
                <circle cx="74" cy="46" r="4.5" fill="#4ade80"/>
                <text x="10" y="36" font-size="12" fill="#4ade80" font-weight="600">A</text>
                <text x="22" y="36" font-size="11" fill="#a79fd4">(Adenine)</text>

                <circle cx="74" cy="196" r="4.5" fill="#60a5fa"/>
                <text x="10" y="216" font-size="12" fill="#60a5fa" font-weight="600">C</text>
                <text x="22" y="216" font-size="11" fill="#a79fd4">(Cytosine)</text>

                <circle cx="224" cy="46" r="4.5" fill="#fbbf24"/>
                <text x="236" y="36" font-size="12" fill="#fbbf24" font-weight="600">G</text>
                <text x="248" y="36" font-size="11" fill="#a79fd4">(Guanine)</text>

                <circle cx="224" cy="196" r="4.5" fill="#f87171"/>
                <text x="236" y="216" font-size="12" fill="#f87171" font-weight="600">T</text>
                <text x="248" y="216" font-size="11" fill="#a79fd4">(Thymine)</text>
            </svg>
        </div>
    </div>
{% endblock %}

{% block result %}
    <div class="bp-figure">
        {% if is_map == 1 %}
            <map name="fcgr-map">
                {% for seq, area in areas %}
                    <area class="mapseq" data-toggle="tooltip" data-placement="top"
                          title="{{ seq }} => {{ oligos[seq] }}"
                          coords="{{ area.0 }}, {{ area.1 }}, {{ area.2 }}, {{ area.3 }}"
                          shape="rect" alt="{{ seq }}" />
                {% endfor %}
            </map>
            <img usemap="#fcgr-map" src="/created_files/{{ image }}" alt="FCGR image of the sequence" />
        {% else %}
            <img src="/created_files/{{ image }}" alt="FCGR image of the sequence" />
        {% endif %}
    </div>

    {% if show_as_freq == 1 %}
        <p>Raw data used to generate images above :</p>
        <div class="bp-tablewrap">
            <table>
                <thead>
                    <tr><th style="width:200px">Sequence</th><th>Occurences</th></tr>
                </thead>
                <tbody>
                    {% for oligo, freq in oligos %}
                        <tr><td>{{ oligo }}</td><td>{{ freq }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}

{% block result_aside %}
    <div class="bp-panel">
        <h3 class="bp-panel__title">Informations</h3>
        <dl class="bp-facts">
            <dt>Oligos</dt><dd>{{ oligos|length }}</dd>
            <dt>Bases</dt><dd>A, C, G, T</dd>
            <dt>Image map</dt><dd>{{ is_map == 1 ? 'on' : 'off' }}</dd>
        </dl>
    </div>

    <div class="bp-panel">
        <h3 class="bp-panel__title">Export</h3>
        <a class="bp-download" href="/created_files/{{ image }}" download>
            <svg aria-hidden="true"><use href="#bp-i-download"></use></svg>
            <span>Télécharger l'image</span>
        </a>
    </div>
{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>
            This script has been extracted from online tools at <a href="http://insilico.ehu.es/" target="_blank" rel="noopener">insilico.ehu.es</a>.
            CGR images for all sequenced bacterial genomes are available
            <a href="http://insilico.ehu.es/describe/" target="_blank" rel="noopener">here</a>. To understand how CGR
            images are generated, check <a href="http://insilico.ehu.es/describe/CGR/info_position_CGR.html" target="_blank" rel="noopener">here</a>.
            Example representations for <i>E. coli</i> K12 :
            <a href="http://insilico.ehu.es/mini_tools/CGR-FCGR/E_coli_K12_CGR.html" target="_blank" rel="noopener">CGR</a>,
            <a href="http://insilico.ehu.es/mini_tools/CGR-FCGR/E_coli_K12_FCGR.html" target="_blank" rel="noopener">FCGR</a>.
            Text taken from <cite title="Source Title">biophp.org</cite>.
        </span>
    </p>
{% endblock %}

{% block js_scripts %}
    $(function () {
        $('[data-toggle="tooltip"]').tooltip()
    });
{% endblock %}
