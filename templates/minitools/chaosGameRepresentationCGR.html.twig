{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'grid' %}
{% set page_title    = 'tool.chaos_game_representation_cgr.page_title'|trans %}
{% set page_subtitle = 'tool.chaos_game_representation_cgr.page_subtitle'|trans %}
{% set has_result    = is_computed %}

{% block intro %}
    <p>{{ 'tool.chaos_game_representation_cgr.intro'|trans|raw }}</p>
{% endblock %}

{% block form_lead %}{{ 'tool.chaos_game_representation_cgr.form_lead'|trans }}{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.seq) }}
        </div>

        <div class="bp-form__col">
            {{ form_row(form.seq_name) }}
            {{ form_row(form.size) }}
            {{ form_row(form.submit, { 'label': 'Create CGR image' }) }}
        </div>

        {% do form.s.setRendered %}
        {% do form.len.setRendered %}
        {% do form.map.setRendered %}
        {% do form.freq.setRendered %}
        {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <div class="bp-figure">
        <img src="/created_files/{{ image }}" alt="CGR image of the sequence" />
    </div>
{% endblock %}

{% block result_aside %}
    <div class="bp-panel">
        <h3 class="bp-panel__title">{{ 'panel.export'|trans }}</h3>
        <a class="bp-download" href="/created_files/{{ image }}" download>
            <svg aria-hidden="true"><use href="#bp-i-download"></use></svg>
            <span>{{ 'action.download_image'|trans }}</span>
        </a>
    </div>
{% endblock %}

{% block description_lead %}{{ 'tool.chaos_game_representation_cgr.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/chaosGameRepresentationCGR.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/chaosGameRepresentationCGR.en.html.twig'
]) }}{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>{{ 'note.insilico'|trans|raw }}</span>
    </p>
{% endblock %}
