{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'ruler' %}
{% set page_title    = 'tool.distance_among_sequences.page_title'|trans %}
{% set page_subtitle = 'tool.distance_among_sequences.page_subtitle'|trans %}
{% set has_result    = oligo_array is not empty %}

{% block intro %}
    <ul>
        <li>{{ 'tool.distance_among_sequences.intro_1'|trans|raw }}</li>
        <li>{{ 'tool.distance_among_sequences.intro_2'|trans|raw }}</li>
        <li>{{ 'tool.distance_among_sequences.intro_3'|trans|raw }}</li>
    </ul>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form bp-form--single'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_widget(form.seq) }}

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.method.0) }}
                    {{ form_label(form.method.0) }}
                </div>
            </div>

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.method.1) }}
                    {{ form_label(form.method.1) }}
                </div>
                {{ form_widget(form.len) }}
            </div>

            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'tool.distance_among_sequences.result_lead'|trans }}{% endblock %}

{% block result %}
    <div class="bp-tablewrap">
        <table>
            <thead>
                <tr>
                    <th>{{ 'tool.distance_among_sequences.distances'|trans }}</th>
                    {% for i in 1..oligo_array|length %}
                        <th>{{ loop.index }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for key, val in data %}
                    <tr>
                        <th>{{ key }}</th>
                        {% for i in 1..oligo_array|length %}
                            <td>{{ data[key][i] is defined ? data[key][i] : '' }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <h5>{{ 'tool.distance_among_sequences.name_of_sequences'|trans }}</h5>
    <pre>{% for n, name in seq_names %}{{ name }}
{% endfor %}</pre>

    <p>{{ 'tool.distance_among_sequences.oligo_length_for_comparison'|trans({'%length%': length}) }}</p>
    <p>{{ 'tool.distance_among_sequences.clustering_method'|trans }}<br />{{ textcluster }}</p>

    <div class="bp-figure">
        <img src="/created_files/{{ dendogram_file }}?{{ "now"|date("U") }}" alt="UPGMA dendrogram" />
    </div>
{% endblock %}

{% block result_aside %}
    <div class="bp-panel">
        <h3 class="bp-panel__title">{{ 'panel.informations'|trans }}</h3>
        <dl class="bp-facts">
            <dt>{{ 'tool.distance_among_sequences.sequences'|trans }}</dt><dd>{{ oligo_array|length }}</dd>
            <dt>{{ 'tool.distance_among_sequences.oligo_length'|trans }}</dt><dd>{{ length }}</dd>
            <dt>{{ 'tool.distance_among_sequences.clustering'|trans }}</dt><dd>UPGMA</dd>
        </dl>
    </div>

    <div class="bp-panel">
        <h3 class="bp-panel__title">{{ 'panel.export'|trans }}</h3>
        <a class="bp-download" href="/created_files/{{ dendogram_file }}" download>
            <svg aria-hidden="true"><use href="#bp-i-download"></use></svg>
            <span>{{ 'action.download_dendrogram'|trans }}</span>
        </a>
    </div>
{% endblock %}

{# cet outil n'a pas de texte de description dans la version d'origine #}
{% block description_step %}{% endblock %}
