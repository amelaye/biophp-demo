{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'thermo' %}
{% set page_title    = 'tool.melting_temperature.page_title'|trans %}
{% set page_subtitle = 'tool.melting_temperature.page_subtitle'|trans %}
{% set has_result    = primer != '' %}

{% block intro %}
    <p>{{ 'tool.melting_temperature.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.primer) }}
            {{ form_row(form.basic) }}
            {{ form_row(form.nearestNeighbor) }}
        </div>

        <div class="bp-form__col">
            <div class="bp-form__inline">
                {{ form_label(form.cp) }}
                {{ form_widget(form.cp) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.cs) }}
                {{ form_widget(form.cs) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.cmg) }}
                {{ form_widget(form.cmg) }}
            </div>
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <pre>{{ '%-25s'|format('tool.melting_temperature.length'|trans) }}{{ primer|length }}</pre>

    {% if cg != 0 %}
        <pre>{{ '%-25s'|format('tool.melting_temperature.cg_percent'|trans) }}{{ cg }}</pre>
    {% endif %}

    {% if upper_mwt != 0 %}
        {% if upper_mwt == lower_mwt %}
            <pre>{{ '%-25s'|format('tool.melting_temperature.molecular_weight'|trans) }}{{ upper_mwt }}</pre>
        {% else %}
            <pre>{{ 'tool.melting_temperature.upper_lower_mwt'|trans({'%upper%': upper_mwt, '%lower%': lower_mwt}) }}</pre>
        {% endif %}
    {% endif %}

    {% if basic == true %}
        <h5>{{ 'tool.melting_temperature.basic_tm_degenerated_nucleotides_are_allowed'|trans }}</h5>
        {% if primer|length != countATGC %}
            <pre>{{ '%-28s'|format('tool.melting_temperature.minimum'|trans) }}<span style="color:#f87171;font-weight: bold;">{{ tm_min }} &deg;C</span></pre>
            <pre>{{ '%-28s'|format('tool.melting_temperature.maximum'|trans) }}<span style="color:#f87171;font-weight: bold;">{{ tm_max }} &deg;C</span></pre>
        {% else %}
            <pre>{{ '%-25s'|format('tool.melting_temperature.tm'|trans) }}<span style="color:#f87171;font-weight: bold;">{{ tm_min }} &deg;C</span></pre>
        {% endif %}
    {% endif %}

    {% if nearest_neighbor == true %}
        <h5>{{ 'tool.melting_temperature.basic_tm_degenerated_nucleotides_are_not_allowed'|trans }}</h5>
        <pre>{{ '%-25s'|format('tool.melting_temperature.tm'|trans) }}<span style="color:#f87171;font-weight: bold;">{{ tmBaseStacking.tm }} &deg;C</span></pre>
        <pre><span style="color:#4ade80;">{{ 'tool.melting_temperature.enthalpy_entropy'|trans({'%enthalpy%': tmBaseStacking.enthalpy, '%entropy%': tmBaseStacking.entropy}) }}</span></pre>
    {% endif %}
{% endblock %}

{% block description_lead %}{{ 'tool.melting_temperature.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/meltingTemperature.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/meltingTemperature.en.html.twig'
]) }}{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>{{ 'note.biophp_credit'|trans({'%source%': '<cite title="Source Title">biophp.org</cite>'})|raw }}</span>
    </p>
{% endblock %}
