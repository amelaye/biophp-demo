{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'chart' %}
{% set page_title    = 'tool.micro_array_analysis_adaptive_quantification.page_title'|trans %}
{% set page_subtitle = 'tool.micro_array_analysis_adaptive_quantification.page_subtitle'|trans %}
{% set has_result    = results is not empty %}

{% block intro %}
    <p>{{ 'tool.micro_array_analysis_adaptive_quantification.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form bp-form--single'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.data) }}
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <div class="bp-tablewrap">
        <table>
            <thead>
                <tr>
                    <th>{{ 'tool.micro_array_analysis_adaptive_quantification.identification'|trans }}</th>
                    <th>{{ 'tool.micro_array_analysis_adaptive_quantification.no_data'|trans }}</th>
                    <th>{{ 'tool.micro_array_analysis_adaptive_quantification.channel_1'|trans }}</th>
                    <th>{{ 'tool.micro_array_analysis_adaptive_quantification.log10'|trans }}</th>
                    <th>{{ 'tool.micro_array_analysis_adaptive_quantification.channel_2'|trans }}</th>
                    <th>{{ 'tool.micro_array_analysis_adaptive_quantification.log10_2'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for key, line in results %}
                    <tr>
                        <td>{{ key }}</td>
                        <td>{{ line.n_data }}</td>
                        <td>{{ line.median1 | round(3, 'common') }}</td>
                        <td class="channel1-log">{{ line.medlog1 }}</td>
                        <td>{{ line.median2 | round(3, 'common') }}</td>
                        <td class="channel2-log">{{ line.medlog2 }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block description_lead %}{{ 'tool.micro_array_analysis_adaptive_quantification.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/microArrayAnalysisAdaptiveQuantification.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/microArrayAnalysisAdaptiveQuantification.en.html.twig'
]) }}{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/minitools/js/microarrayAnalysisAdaptive.js') }}"></script>
{% endblock %}

{% block js_scripts %}
    getColorChannel(".channel1-log");
    getColorChannel(".channel2-log");
{% endblock %}
