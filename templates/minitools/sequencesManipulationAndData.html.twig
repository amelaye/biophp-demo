{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'atgc' %}
{% set page_title    = 'tool.sequences_manipulation_and_data.page_title'|trans %}
{% set has_result    = result != "" %}

{% block intro %}
    <p>{{ 'tool.sequences_manipulation_and_data.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.seq) }}
        </div>

        <div class="bp-form__col">
            {{ form_row(form.action) }}
            <div class="bp-form__pair">
                {{ form_row(form.start) }}
                {{ form_row(form.end) }}
            </div>
            {{ form_row(form.GC) }}
            {{ form_row(form.ACGT) }}
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <pre>{{ result | chunk_split(70) }}</pre>
{% endblock %}

{% block description_lead %}{{ 'tool.sequences_manipulation_and_data.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/sequencesManipulationAndData.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/sequencesManipulationAndData.en.html.twig'
]) }}{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>{{ 'note.biophp_credit'|trans({'%source%': '<cite title="Source Title">biophp.org</cite>'})|raw }}</span>
    </p>
{% endblock %}
