{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'atgc' %}
{% set page_title    = 'DNA Sequence manipulation' %}
{% set has_result    = result != "" %}

{% block intro %}
    <p>Manipulate a DNA sequence and read its properties.</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.seq) }}
        </div>

        <div class="bp-form__col">
            {{ form_row(form.action) }}
            <div class="bp-form__pair">
                {{ form_row(form.start) }}
                {{ form_row(form.end) }}
            </div>
            {{ form_row(form.GC) }}
            {{ form_row(form.ACGT) }}
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}Results of your request{% endblock %}

{% block result %}
    <pre>{{ result | chunk_split(70) }}</pre>
{% endblock %}

{% block description_lead %}DNA sequence manipulation{% endblock %}

{% block description %}
    <p><b>NOTES</b>:</p>
    <p>
        Non-coding characters will be removed by default, and X is replaced by N.<br>
        <a href="http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?cmd=retrieve&amp;db=pubmed&amp;list_uids=7957164&amp;dopt=abstract"
           target="_blank" rel="noopener">NC-UIBMB</a> codes are used as a reference.
    </p>
{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>Text taken from <cite title="Source Title">biophp.org</cite>.</span>
    </p>
{% endblock %}
