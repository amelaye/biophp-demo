{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'calc' %}
{% set page_title    = 'Useful formulas' %}
{% set page_subtitle = 'Formula functions' %}
{% set has_result    = result is not null %}

{% block intro %}
    <p>Molecular weight, quantity and unit conversions for DNA, RNA and proteins.</p>
{% endblock %}

{% block form_lead %}Pick a formula, then fill in the values it needs.{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.formula) }}
            {{ form_row(form.sequence) }}
        </div>

        <div class="bp-form__col">
            <div class="bp-form__inline">
                {{ form_label(form.quantity) }}
                {{ form_widget(form.quantity) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.value) }}
                {{ form_widget(form.value) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.molecularWeight) }}
                {{ form_widget(form.molecularWeight) }}
            </div>
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}Results of your request{% endblock %}

{% block result %}
    <pre>{{ result|number_format(4, '.', '') }}</pre>
{% endblock %}

{# cet outil n'a pas de texte de description dans la version d'origine #}
