{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'percent' %}
{% set page_title    = 'Fasta Upload' %}
{% set page_subtitle = 'GC Content Finder' %}
{% set has_result    = length != 0 %}

{% block intro %}
    <p>
        Compute the GC content of an uploaded FASTA file: total length, base counts and the
        AT / GC percentages of the sequence.
    </p>
{% endblock %}

{% block form_lead %}Important: Please use only txt files. The file should contain only letters.{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form bp-form--single'}}) }}
        <div class="bp-form__col">
            {{ form_widget(form) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}Results of your request{% endblock %}

{% block result %}
    <dl class="bp-facts">
        <dt>Total Length of Sequence</dt><dd>{{ length }}</dd>
        <dt>Number of A</dt><dd>{{ a }}</dd>
        <dt>Number of T</dt><dd>{{ t }}</dd>
        <dt>Number of G</dt><dd>{{ g }}</dd>
        <dt>Number of C</dt><dd>{{ c }}</dd>
        <dt>% of at</dt><dd>{{ at }}</dd>
        <dt>% of gc</dt><dd>{{ gc }}</dd>
    </dl>
{% endblock %}

{# cet outil n'a pas de texte de description dans la version d'origine #}
{% block description_step %}{% endblock %}
