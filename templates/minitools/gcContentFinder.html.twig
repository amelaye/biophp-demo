{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'percent' %}
{% set page_title    = 'tool.gc_content_finder.page_title'|trans %}
{% set page_subtitle = 'tool.gc_content_finder.page_subtitle'|trans %}
{% set has_result    = length != 0 %}

{% block intro %}
    <p>{{ 'tool.gc_content_finder.intro'|trans|raw }}</p>
{% endblock %}

{% block form_lead %}{{ 'tool.gc_content_finder.form_lead'|trans }}{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form bp-form--single'}}) }}
        <div class="bp-form__col">
            {{ form_widget(form) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <dl class="bp-facts">
        <dt>{{ 'tool.gc_content_finder.total_length_of_sequence'|trans }}</dt><dd>{{ length }}</dd>
        <dt>{{ 'tool.gc_content_finder.number_of_a'|trans }}</dt><dd>{{ a }}</dd>
        <dt>{{ 'tool.gc_content_finder.number_of_t'|trans }}</dt><dd>{{ t }}</dd>
        <dt>{{ 'tool.gc_content_finder.number_of_g'|trans }}</dt><dd>{{ g }}</dd>
        <dt>{{ 'tool.gc_content_finder.number_of_c'|trans }}</dt><dd>{{ c }}</dd>
        <dt>{{ 'tool.gc_content_finder.of_at'|trans }}</dt><dd>{{ at }}</dd>
        <dt>{{ 'tool.gc_content_finder.of_gc'|trans }}</dt><dd>{{ gc }}</dd>
    </dl>
{% endblock %}

{# cet outil n'a pas de texte de description dans la version d'origine #}
{% block description_step %}{% endblock %}
