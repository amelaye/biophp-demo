{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'atgc' %}
{% set page_title    = 'tool.dna_to_protein.page_title'|trans %}
{% set has_result    = frames is not empty %}

{% block intro %}
    <p>{{ 'tool.dna_to_protein.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}

            <div class="bp-form__toolbar">
                <button type="button" id="tidyup-button">{{ 'tool.dna_to_protein.tidy_up'|trans }}</button>
                <button type="button" id="reverse-button">{{ 'tool.dna_to_protein.reverse'|trans }}</button>
                <button type="button" id="complement-button">{{ 'tool.dna_to_protein.complement'|trans }}</button>
                <button type="button" id="clear-button">{{ 'tool.dna_to_protein.clear'|trans }}</button>
            </div>

            {{ form_row(form.sequence) }}

            <div class="bp-form__inline">
                {{ form_label(form.frames) }}
                {{ form_widget(form.frames) }}
            </div>
            {{ form_row(form.dgaps) }}
            {{ form_row(form.show_aligned) }}
        </div>

        <div class="bp-form__col">
            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.search_orfs) }}
                    {{ form_label(form.search_orfs) }}
                </div>
                <div class="bp-form__inline">
                    {{ form_label(form.protsize) }}
                    {{ form_widget(form.protsize) }}
                </div>
                {{ form_row(form.only_coding) }}
                {{ form_row(form.trimmed) }}
            </div>

            {{ form_row(form.genetic_code) }}
            {{ form_row(form.usemycode) }}
            {{ form_row(form.mycode) }}
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    {% if show_aligned %}
        <h5>{{ 'tool.dna_to_protein.translation_of_requested_code_5_gt_3'|trans }}</h5>
        <pre>{{ scale_and_bar() }}<br />{{ aligned_results|raw|upper }}</pre>
    {% endif %}

    {% if aligned_results_compl != "" %}
        <h5>{{ 'tool.dna_to_protein.translation_of_requested_code_complementary_dna_chain'|trans }}</h5>
        <pre>{{ scale_and_bar() }}<br />{{ aligned_results_compl|raw }}</pre>
    {% endif %}

    {% for key, frame in frames %}
        <h5>{{ 'tool.dna_to_protein.frame'|trans({'%n%': key}) }}</h5>
        {% if dgaps %}
            <pre>{{ frame | chunk_split(1, '--') | chunk_split(100, '<br>') |raw }}</pre>
        {% else %}
            <pre>{{ frame | chunk_split(100, '<br>') | raw }}</pre>
        {% endif %}
    {% endfor %}
{% endblock %}

{% block description_lead %}{{ 'tool.dna_to_protein.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/dnaToProtein.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/dnaToProtein.en.html.twig'
]) }}{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>{{ 'note.biophp_credit'|trans({'%source%': '<cite title="Source Title">biophp.org</cite>'})|raw }}</span>
    </p>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/dnatoprotein.js') }}"></script>
{% endblock %}
