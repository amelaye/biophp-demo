{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'shuffle' %}
{% set page_title    = 'tool.random_seqs.page_title'|trans %}
{% set has_result    = results != "" %}

{% block intro %}
    <p>{{ 'tool.random_seqs.intro'|trans|raw }}</p>
{% endblock %}

{% block form_lead %}{{ 'tool.random_seqs.form_lead'|trans }}{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form bp-form--single'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.procedure.0) }}
                    {{ form_label(form.procedure.0) }}
                </div>
                {{ form_row(form.seq) }}
                <p class="bp-form__help">{{ 'tool.random_seqs.dna_or_protein_nature_of_the_sequence'|trans }}</p>
                <div class="bp-form__inline">
                    {{ form_label(form.length1) }}
                    {{ form_widget(form.length1) }}
                </div>
            </div>

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.procedure.1) }}
                    {{ form_label(form.procedure.1) }}
                </div>
                <div class="bp-form__inline">
                    {{ form_label(form.length2) }}
                    {{ form_widget(form.length2) }}
                </div>
                <div class="bp-form__cells">
                    <div class="bp-form__cell">{{ form_label(form.dnaA) }}{{ form_widget(form.dnaA) }}</div>
                    <div class="bp-form__cell">{{ form_label(form.dnaC) }}{{ form_widget(form.dnaC) }}</div>
                    <div class="bp-form__cell">{{ form_label(form.dnaG) }}{{ form_widget(form.dnaG) }}</div>
                    <div class="bp-form__cell">{{ form_label(form.dnaT) }}{{ form_widget(form.dnaT) }}</div>
                </div>
            </div>

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.procedure.2) }}
                    {{ form_label(form.procedure.2) }}
                </div>
                <div class="bp-form__inline">
                    {{ form_label(form.length3) }}
                    {{ form_widget(form.length3) }}
                </div>
                <div class="bp-form__cells">
                    {% for field in ['a','c','d','e','f','g','h','i','k','l','m','n','p','q','r','s','t','v','w','y'] %}
                        <div class="bp-form__cell">
                            {{ form_label(attribute(form, field)) }}
                            {{ form_widget(attribute(form, field)) }}
                            <span class="bp-form__unit">&permil;</span>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <h5>{{ 'tool.random_seqs.random_sequences'|trans }}</h5>
    <pre>{{ results|chunk_split(70, '<br>') }}</pre>
{% endblock %}

{% block description_lead %}{{ 'tool.random_seqs.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/randomSeqs.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/randomSeqs.en.html.twig'
]) }}{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>{{ 'note.biophp_credit'|trans({'%source%': '<cite title="Source Title">biophp.org</cite>'})|raw }}</span>
    </p>
{% endblock %}
