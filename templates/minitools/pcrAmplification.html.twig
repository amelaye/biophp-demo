{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'dna' %}
{% set page_title    = 'tool.pcr_amplification.page_title'|trans %}
{% set has_result    = results is not empty %}

{% block intro %}
    <p>{{ 'tool.pcr_amplification.intro_1'|trans|raw }}</p>
    <p>{{ 'tool.pcr_amplification.intro_2'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.sequence) }}
        </div>

        <div class="bp-form__col">
            <div class="bp-form__inline">
                {{ form_label(form.primer1) }}
                {{ form_widget(form.primer1) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.primer2) }}
                {{ form_widget(form.primer2) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.allowmismatch) }}
                {{ form_widget(form.allowmismatch) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.length) }}
                {{ form_widget(form.length) }}
            </div>
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <pre>{{ 'tool.pcr_amplification.primer_1'|trans }} {{ primer1 }}</pre>
    <pre>{{ 'tool.pcr_amplification.primer_2'|trans }} {{ primer2 }}</pre>

    <h5>{{ 'tool.pcr_amplification.list_of_amplicons_position_in_sequence_length'|trans }}</h5>
    {% for key, val in results %}
        <pre>{{ key }} {{ val }}     {{ sequence|slice(key, val) }}</pre>
    {% endfor %}
{% endblock %}

{# cet outil n'a pas de texte de description dans la version d'origine #}
{% block description_step %}{% endblock %}
