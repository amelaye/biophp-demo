{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'chart' %}
{% set page_title    = 'tool.oligonucleotide_frequency.page_title'|trans %}
{% set page_subtitle = 'tool.oligonucleotide_frequency.page_subtitle'|trans %}
{% set has_result    = results is not empty %}

{% block intro %}
    <p>{{ 'tool.oligonucleotide_frequency.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.sequence) }}
            <p class="bp-form__help">{{ 'tool.oligonucleotide_frequency.non_coding_characters_as_number_returns_or'|trans }}</p>
        </div>

        <div class="bp-form__col">
            <div class="bp-form__inline">
                {{ form_label(form.len) }}
                {{ form_widget(form.len) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.strands) }}
                {{ form_widget(form.strands) }}
            </div>
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <h5>{{ 'tool.oligonucleotide_frequency.oligos_with_length'|trans({'%length%': length}) }}</h5>
    <div class="bp-tablewrap">
        <table>
            <thead>
                <tr><th>{{ 'tool.oligonucleotide_frequency.oligo'|trans }}</th><th>{{ 'tool.oligonucleotide_frequency.frequency'|trans }}</th></tr>
            </thead>
            <tbody>
                {% for frequency, oligo in results %}
                    <tr><td>{{ frequency }}</td><td>{{ oligo }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{# cet outil n'a pas de texte de description dans la version d'origine #}
{% block description_step %}{% endblock %}
