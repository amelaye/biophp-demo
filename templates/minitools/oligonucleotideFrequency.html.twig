{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'chart' %}
{% set page_title    = 'Frequency of nucleotides' %}
{% set page_subtitle = 'and oligonucleotides in a sequence' %}
{% set has_result    = results is not empty %}

{% block intro %}
    <p>
        This demo is limited to oligos 1-3 bases long, and a maximum input sequence of 10000 bp.
        This version does not work with degenerated nucleotides.
    </p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.sequence) }}
            <p class="bp-form__help">(non coding characters, as number, returns or spaces will be removed)</p>
        </div>

        <div class="bp-form__col">
            <div class="bp-form__inline">
                {{ form_label(form.len) }}
                {{ form_widget(form.len) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.strands) }}
                {{ form_widget(form.strands) }}
            </div>
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}Results of your request{% endblock %}

{% block result %}
    <h5>Frequencie of oligos with length {{ length }}</h5>
    <div class="bp-tablewrap">
        <table>
            <thead>
                <tr><th>Oligo</th><th>Frequency</th></tr>
            </thead>
            <tbody>
                {% for frequency, oligo in results %}
                    <tr><td>{{ frequency }}</td><td>{{ oligo }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

