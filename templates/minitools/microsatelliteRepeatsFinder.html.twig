{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'search' %}
{% set page_title    = 'Microsatellite repeats finder' %}
{% set has_result    = results is not empty %}

{% block intro %}
    <p>Detect short tandem repeats in a DNA sequence.</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.sequence) }}
        </div>

        <div class="bp-form__col">
            <div class="bp-form__inline">
                {{ form_label(form.min) }}
                {{ form_widget(form.min) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.max) }}
                {{ form_widget(form.max) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.min_repeats) }}
                {{ form_widget(form.min_repeats) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.length_of_MR) }}
                {{ form_widget(form.length_of_MR) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.mismatch) }}
                {{ form_widget(form.mismatch) }}
            </div>
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}Results of your request{% endblock %}

{% block result %}
    <div class="bp-tablewrap">
        <table>
            <thead>
                <tr><th>Position</th><th>Cicle</th><th>Repeats</th><th>Sequence</th></tr>
            </thead>
            <tbody>
                {% for val in results %}
                    <tr>
                        <td>{{ val.start_position }}</td>
                        <td>{{ val.length }}</td>
                        <td>{{ val.repeats }}</td>
                        <td>{{ val.sequence }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block description_lead %}Definitions{% endblock %}

{% block description %}
    <h5>Microsatellite Repeat</h5>
    <p>
        A variety of simple di- (DINUCLEOTIDE REPEATS), tri- (TRINUCLEOTIDE REPEATS), tetra-,
        and pentanucleotide tandem repeats (usually less than 100 bases long).
    </p>

    <h5>Tandem repeats</h5>
    <p>Copies of DNA sequences which lie adjacent to each other.</p>

    <h5>Related terms</h5>
    <p>
        Simple Tandem Repeats (STR), Exact Tandem Repeats (ETRs), Short Sequence Repeats (SSRs),
        Repetitive DNA, Simple Sequence Repeats (SSR).
    </p>
{% endblock %}
