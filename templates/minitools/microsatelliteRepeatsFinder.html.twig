{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'search' %}
{% set page_title    = 'tool.microsatellite_repeats_finder.page_title'|trans %}
{% set has_result    = results is not empty %}

{% block intro %}
    <p>{{ 'tool.microsatellite_repeats_finder.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.sequence) }}
        </div>

        <div class="bp-form__col">
            <div class="bp-form__inline">
                {{ form_label(form.min) }}
                {{ form_widget(form.min) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.max) }}
                {{ form_widget(form.max) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.min_repeats) }}
                {{ form_widget(form.min_repeats) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.length_of_MR) }}
                {{ form_widget(form.length_of_MR) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.mismatch) }}
                {{ form_widget(form.mismatch) }}
            </div>
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <div class="bp-tablewrap">
        <table>
            <thead>
                <tr><th>{{ 'tool.microsatellite_repeats_finder.position'|trans }}</th><th>{{ 'tool.microsatellite_repeats_finder.cicle'|trans }}</th><th>{{ 'tool.microsatellite_repeats_finder.repeats'|trans }}</th><th>{{ 'tool.microsatellite_repeats_finder.sequence'|trans }}</th></tr>
            </thead>
            <tbody>
                {% for val in results %}
                    <tr>
                        <td>{{ val.start_position }}</td>
                        <td>{{ val.length }}</td>
                        <td>{{ val.repeats }}</td>
                        <td>{{ val.sequence }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block description_lead %}{{ 'tool.microsatellite_repeats_finder.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/microsatelliteRepeatsFinder.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/microsatelliteRepeatsFinder.en.html.twig'
]) }}{% endblock %}
