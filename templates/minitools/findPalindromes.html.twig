{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'search' %}
{% set page_title    = 'Palindromic sequences finder' %}
{% set has_result    = palindromes is not empty %}

{% block intro %}
    <p>Locate palindromic motifs in a DNA sequence.</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form bp-form--single'}}) }}
        <div class="bp-form__col">
            {{ form_widget(form) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}Palindromic sequences with length {{ min }} to {{ max }} within string{% endblock %}

{% block result %}
    <div class="bp-tablewrap">
        <table>
            <thead>
                <tr><th>Position</th><th>Sequence</th></tr>
            </thead>
            <tbody>
                {% for key, palindrome in palindromes %}
                    <tr><td>{{ key }}</td><td>{{ palindrome }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block description_lead %}Definitions{% endblock %}

{% block description %}
    <h5>Palindromic sequence</h5>
    <p>
        A DNA sequence whose 5'-to-3' sequence is identical on each DNA strand.
        The sequence is the same when one strand is read left to right and the other strand is read right to left.
        Recognition sites of many restriction enzymes are palindromic.
    </p>
{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>Text taken from <cite title="Source Title">biophp.org</cite>.</span>
    </p>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/minitools/js/dnatoprotein.js') }}"></script>
{% endblock %}
