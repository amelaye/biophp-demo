{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'search' %}
{% set page_title    = 'tool.find_palindromes.page_title'|trans %}
{% set has_result    = palindromes is not empty %}

{% block intro %}
    <p>{{ 'tool.find_palindromes.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form bp-form--single'}}) }}
        <div class="bp-form__col">
            {{ form_widget(form) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'tool.find_palindromes.result_lead'|trans({'%min%': min, '%max%': max}) }}{% endblock %}

{% block result %}
    <div class="bp-tablewrap">
        <table>
            <thead>
                <tr><th>{{ 'tool.find_palindromes.position'|trans }}</th><th>{{ 'tool.find_palindromes.sequence'|trans }}</th></tr>
            </thead>
            <tbody>
                {% for key, palindrome in palindromes %}
                    <tr><td>{{ key }}</td><td>{{ palindrome }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block description_lead %}{{ 'tool.find_palindromes.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/findPalindromes.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/findPalindromes.en.html.twig'
]) }}{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>{{ 'note.biophp_credit'|trans({'%source%': '<cite title="Source Title">biophp.org</cite>'})|raw }}</span>
    </p>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/minitools/js/dnatoprotein.js') }}"></script>
{% endblock %}
