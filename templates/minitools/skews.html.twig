{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'wave' %}
{% set page_title    = 'tool.skews.page_title'|trans %}
{% set page_subtitle = 'tool.skews.page_subtitle'|trans %}
{% set has_result    = image != "" %}

{% block intro %}
    <p>{{ 'tool.skews.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.seq) }}
        </div>

        <div class="bp-form__col">
            <div class="bp-form__pair">
                {{ form_row(form.window) }}
                {{ form_row(form.window2) }}
            </div>
            <p class="bp-form__help">{{ 'tool.skews.bases_100_50000'|trans }}</p>

            <hr />

            {{ form_row(form.GmC) }}
            {{ form_row(form.GC) }}
            {{ form_row(form.AT) }}
            {{ form_row(form.KETO) }}

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.oskew) }}
                    {{ form_label(form.oskew) }}
                </div>
                <div class="bp-form__pair">
                    {{ form_row(form.oligo_len) }}
                    {{ form_row(form.strands) }}
                </div>
            </div>

            <hr />

            <div class="bp-form__pair">
                {{ form_row(form.from) }}
                {{ form_row(form.to) }}
            </div>

            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <div class="bp-figure">
        <img src="/created_files/{{ image }}" alt="Skew graph of the sequence" />
    </div>
{% endblock %}

{% block result_aside %}
    <div class="bp-panel">
        <h3 class="bp-panel__title">{{ 'panel.export'|trans }}</h3>
        <a class="bp-download" href="/created_files/{{ image }}" download>
            <svg aria-hidden="true"><use href="#bp-i-download"></use></svg>
            <span>{{ 'action.download_chart'|trans }}</span>
        </a>
    </div>
{% endblock %}

{% block description_lead %}{{ 'tool.skews.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/skews.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/skews.en.html.twig'
]) }}{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>{{ 'note.biophp_credit'|trans({'%source%': '<cite title="Source Title">biophp.org</cite>'})|raw }}</span>
    </p>
{% endblock %}
