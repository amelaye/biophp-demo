{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'protein' %}
{% set page_title    = 'tool.reduce_protein_alphabet.page_title'|trans %}
{% set page_subtitle = 'tool.reduce_protein_alphabet.page_subtitle'|trans %}
{% set has_result    = reduced_seq != "" %}

{% block intro %}
    <p>{{ 'tool.reduce_protein_alphabet.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form bp-form--single'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.seq) }}

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.mode.0) }}
                    {{ form_label(form.mode.0) }}
                </div>
                {{ form_widget(form.type) }}
            </div>

            <div class="bp-form__group">
                <div class="bp-form__group-head">
                    {{ form_widget(form.mode.1) }}
                    {{ form_label(form.mode.1) }}
                </div>
                {{ form_widget(form.custom_alphabet) }}
            </div>

            <div class="bp-form__inline">
                {{ form_label(form.aaperline) }}
                {{ form_widget(form.aaperline) }}
            </div>

            <div class="bp-form__inline">
                {{ form_label(form.show_reduced) }}
                {{ form_widget(form.show_reduced) }}
            </div>

            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    {% if reduced_code is not empty %}
        <h5>{{ reduced_code.Description }}</h5>
        {% for key, element in reduced_code.Elements %}
            {{ key }} =&gt; {{ element }}<br />
        {% endfor %}
    {% endif %}

    {% if mode == "custom" %}
        <h5>{{ 'tool.reduce_protein_alphabet.personalized_alphabet'|trans }}</h5>
        <pre>{{ '%-14s'|format('tool.reduce_protein_alphabet.aminoacids'|trans) }}{{ "ARNDCEQGHILKMFPSTWYV" | chunk_split(aa_perline) | color_amino_custom(custom_alphabet, custom_alphabet) }}
{{ '%-14s'|format('tool.reduce_protein_alphabet.reduced_code'|trans) }}{{ custom_alphabet | chunk_split(aa_perline) | color_amino_custom(custom_alphabet, custom_alphabet) }} </pre>
    {% endif %}

    {% if show_reduced %}
        <h5>{{ 'tool.reduce_protein_alphabet.reduced_alphabet'|trans }}</h5>
        {% if mode == "custom" %}
            <pre>{{ reduced_seq | chunk_split(aa_perline) | color_amino_custom(reduced_seq, custom_alphabet) }}</pre>
        {% elseif mode == "pre" %}
            <pre>{{ reduced_seq | chunk_split(aa_perline) | color_amino(reduced_seq, type) }}</pre>
        {% endif %}
    {% endif %}

    <h5>{{ 'tool.reduce_protein_alphabet.colored_sequence'|trans }}</h5>
    {% if mode == "custom" %}
        <pre>{{ sequence | chunk_split(aa_perline) | color_amino_custom(reduced_seq, custom_alphabet) }}</pre>
    {% elseif mode == "pre" %}
        <pre>{{ sequence | chunk_split(aa_perline) | color_amino(reduced_seq, type) }}</pre>
    {% endif %}
{% endblock %}

{% block description_lead %}{{ 'tool.reduce_protein_alphabet.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/reduceProteinAlphabet.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/reduceProteinAlphabet.en.html.twig'
]) }}{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>{{ 'note.biophp_credit'|trans({'%source%': '<cite title="Source Title">biophp.org</cite>'})|raw }}</span>
    </p>
{% endblock %}
