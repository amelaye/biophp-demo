{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'align' %}
{% set page_title    = 'tool.seq_alignment.page_title'|trans %}
{% set page_subtitle = 'tool.seq_alignment.page_subtitle'|trans %}
{% set has_result    = compare != "" %}

{% block intro %}
    <p>{{ 'tool.seq_alignment.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.id1) }}
            {{ form_row(form.sequence) }}
        </div>

        <div class="bp-form__col">
            {{ form_row(form.id2) }}
            {{ form_row(form.sequence2) }}
        </div>

        <div class="bp-form__full">
            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    <div class="bp-seq">{{ compare | dispose_sequences(align_seqa, align_seqb) }}</div>

    <h5>{{ sequence1 }}</h5>
    <input type="text" value="{{ align_seqa }}" readonly>

    <h5>{{ sequence2 }}</h5>
    <input type="text" value="{{ align_seqb }}" readonly>
{% endblock %}

{% block description_lead %}{{ 'tool.seq_alignment.description_lead'|trans }}{% endblock %}

{% block description %}{{ include([
    'minitools/_description/seqAlignment.' ~ app.request.locale ~ '.html.twig',
    'minitools/_description/seqAlignment.en.html.twig'
]) }}{% endblock %}

{% block note %}
    <p class="bp-note">
        <svg aria-hidden="true"><use href="#bp-i-info"></use></svg>
        <span>{{ 'note.biophp_credit'|trans({'%source%': '<cite title="Source Title">biophp.org</cite>'})|raw }}</span>
    </p>
{% endblock %}
