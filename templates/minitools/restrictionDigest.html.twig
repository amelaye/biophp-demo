{% extends 'layout/minitool.html.twig' %}

{% set page_icon     = 'scissors' %}
{% set page_title    = 'tool.restriction_digest.page_title'|trans %}
{% set page_subtitle = 'tool.restriction_digest.page_subtitle'|trans %}
{% set has_result    = digestion is not empty %}

{% block intro %}
    <p>{{ 'tool.restriction_digest.intro'|trans|raw }}</p>
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'class': 'bp-form'}}) }}
        <div class="bp-form__col">
            {{ form_errors(form) }}
            {{ form_row(form.sequence) }}
        </div>

        <div class="bp-form__col">
            <div class="bp-form__inline">
                {{ form_label(form.showcode) }}
                {{ form_widget(form.showcode) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.minimum) }}
                {{ form_widget(form.minimum) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.retype) }}
                {{ form_widget(form.retype) }}
            </div>
            <div class="bp-form__inline">
                {{ form_label(form.wre) }}
                {{ form_widget(form.wre) }}
            </div>

            <hr />

            {{ form_row(form.defined) }}
            {{ form_row(form.IIb) }}
            {{ form_row(form.IIs) }}

            <hr />

            <p class="bp-form__help">{{ 'tool.restriction_digest.when_two_or_more_input_sequences_are'|trans }}</p>
            {{ form_row(form.onlydiff) }}

            {{ form_row(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block result_lead %}{{ 'step.results_of_request'|trans }}{% endblock %}

{% block result %}
    {% if show_code %}
        {% for key, val in sequence %}
            {% if sequence.key['name'] is defined %}
                <h5>{{ sequence.key['name'] }}</h5>
            {% endif %}
            {% set seq = sequence[key]['seq'] %}
            {% set countG = seq|split('G')|length - 1 %}
            {% set countC = seq|split('C')|length - 1 %}
            {% set result = (countG + countC ) * 100 / seq | length %}
            <p><b>{{ 'tool.restriction_digest.length_of_code'|trans({'%length%': seq|length}) }}</b><br />G + C = {{ result | round(1, 'floor') }} %</p>
            <div class="bp-seq">{{ seq | digest_code }}</div>
        {% endfor %}
    {% endif %}

    <div class="bp-tablewrap">
        <table class="biotable">
            <thead>
                <tr>
                    <th>{{ 'tool.restriction_digest.restriction_enzyme'|trans }}</th>
                    {% if sequence | length == 1 %}
                        <th>{{ 'tool.restriction_digest.cuts'|trans }}</th>
                        <th>{{ 'tool.restriction_digest.positions'|trans }}</th>
                    {% else %}
                        {% for key, val in sequence %}
                            <th>{{ 'tool.restriction_digest.seq_n'|trans({'%n%': key + 1}) }}</th>
                        {% endfor %}
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% if sequence | length == 1 %}
                    {# Only one input sequence available #}
                    {% for enzyme, val in digestion.0 %}
                        <tr>
                            <td style="width:300px">
                                <a href="#" class="vendor_link" id="{{ enzymes_array[enzyme][0] }}">{{ enzymes_array[enzyme][0] }}</a>
                                <pre>{{ enzymes_array[enzyme][1] }}</pre>
                            </td>
                            <td>
                                {% if '#' in enzyme %}
                                    {{ (digestion[0][enzyme]["cuts"] | length) * 2 }}
                                {% else %}
                                    {{ (digestion[0][enzyme]["cuts"] | length) }}
                                {% endif %}
                            </td>
                            <td>
                                {% for pos, v in digestion[0][enzyme]["cuts"] %}
                                    {% if '#' in enzyme %}
                                        {% set second_cut = pos + enzymes_array[enzyme][3] - enzymes_array[enzyme][4] %}
                                        {{ pos / second_cut }}
                                    {% else %}
                                        {{ pos }}
                                    {% endif %}
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    {# Two or more sequence available #}
                    {% for enzyme, val in enzymes_array %}
                        {% for key, data in digestion_multi %}
                            {% if data == enzyme %}
                                <tr>
                                    <td style="width:300px">
                                        <a href="#" class="vendor_link" id="{{ enzymes_array[enzyme][0] }}">{{ enzymes_array[enzyme][0] }}</a>
                                        <pre>{{ enzymes_array[enzyme][1] }}</pre>
                                    </td>
                                    {% for number, val2 in sequence %}
                                        {% if digestion[number][enzyme] is defined %}
                                            <td>
                                                {% for pos, nothing in digestion[number][enzyme]["cuts"] %}
                                                    {% if "#" in enzyme %}
                                                        {% set second_cut = pos + enzymes_array[enzyme][3] - enzymes_array[enzyme][4] %}
                                                        {{ pos / second_cut }}
                                                    {% else %}
                                                        {{ pos }}
                                                    {% endif %}
                                                {% endfor %}
                                            </td>
                                        {% else %}
                                            <td>&nbsp;</td>
                                        {% endif %}
                                    {% endfor %}
                                </tr>
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block result_aside %}
    {# rempli en Ajax au clic sur un nom d'enzyme #}
    <div class="bp-panel bp-panel--live" id="vendors"></div>
{% endblock %}

{# cet outil n'a pas de texte de description dans la version d'origine #}
{% block description_step %}{% endblock %}

{% block js_scripts %}
        $(".vendor_link").click(function() {
            $.ajax({
                url : '/minitools/show-vendors/' + $(this).attr("id"),
                type: 'GET',
                dataType: 'json'
            })
            .done(function(data) {
                $("#vendors").html('');
                $("#vendors").append({{ ('<h3 class="bp-panel__title">' ~ 'panel.vendors'|trans ~ '</h3>')|json_encode|raw }});
                $("#vendors").append('<p>'+data.message+'</p>');
                $.each(data.vendors, function( index, value ) {
                    $("#vendors").append('<h5>'+index+'</h5> > <a href="'+value.company.url+'">REBASE</a>');
                    var urls = '';
                    $.each(value.links, function( key, url ) {
                        urls = urls + '<li><a href="'+url.url+'">'+url.name+'</a></li>';
                    });
                    $("#vendors").append('<ul>'+urls+'</ul>');
                });
            });
        });
{% endblock %}
