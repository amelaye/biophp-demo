<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}{{ 'page.welcome'|trans }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/bootstrap.css') }}">
    <link rel="icon" type="image/png" href="{{ asset('img/biophp-mark.png') }}">
    {% block stylesheets %}{% endblock %}
    <style>
        table .biotable, .biotable th, .biotable td {
            border: 1px solid black;
        }
        td {
            vertical-align: top;
        }
        th, td {
            padding: 15px;
            text-align: left;
        }
    </style>
</head>
<body>
<div class="container">
    {% block body %}{% endblock %}
</div>
<script src="{{ asset('js/jquery-3.3.1.min.js') }}"></script>
<script src="{{ asset('js/popper.min.js') }}"></script>
<script src="{{ asset('js/bootstrap.min.js') }}"></script>
{% block javascripts %}
{% endblock %}
<script type="text/javascript">
    {% block js_scripts %}
    {% endblock %}
</script>
</body>
</html>