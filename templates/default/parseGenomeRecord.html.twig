{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'file' %}
{% set page_title = 'doc.parseGenomeRecord.page_title'|trans %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.common.parsed_record'|trans }}</summary>
            <div class="card-body">
                    <table class="table table-sm">
                        <tr><th>{{ 'doc.common.organism'|trans }}</th><td>{{ organism }}</td></tr>
                        <tr><th>{{ 'doc.common.common_name'|trans }}</th><td>{{ commonName }}</td></tr>
                        <tr><th>{{ 'doc.parseGenomeRecord.taxonomic_class'|trans }}</th><td>{{ macros.render_value(taxClass) }}</td></tr>
                        <tr><th>{{ 'doc.parseGenomeRecord.is_complete'|trans }}</th><td>{{ isComplete }}</td></tr>
                        <tr><th>{{ 'doc.parseGenomeRecord.genbank_release'|trans }}</th><td>{{ gbRelease }}</td></tr>
                        <tr><th>{{ 'doc.parseGenomeRecord.genbank_entries'|trans }}</th><td>{{ gbEntries }}</td></tr>
                        <tr><th>{{ 'doc.parseGenomeRecord.genbank_basepairs'|trans }}</th><td>{{ gbBasepairs }}</td></tr>
                        <tr><th>{{ 'doc.parseGenomeRecord.genome_size_bp'|trans }}</th><td>{{ size }}</td></tr>
                    </table>
            </div>
        </details>
    </div>
{% endblock %}
