{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as macros %}
{% block body %}
    <div class="container">
        <h1>GENOME: whole-genome record</h1>
        <br>
        <h4>Sample code : </h4>
        <br>
        {{ code | raw }}
        <br>
        <h4>Result :</h4>
        <div class="card border-info mb-3" style="font-size:0.9em">
            <div class="card-header">Results of your request</div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr><th>Organism</th><td>{{ organism }}</td></tr>
                    <tr><th>Common name</th><td>{{ commonName }}</td></tr>
                    <tr><th>Taxonomic class</th><td>{{ macros.render_value(taxClass) }}</td></tr>
                    <tr><th>Is complete</th><td>{{ isComplete }}</td></tr>
                    <tr><th>GenBank release</th><td>{{ gbRelease }}</td></tr>
                    <tr><th>GenBank entries</th><td>{{ gbEntries }}</td></tr>
                    <tr><th>GenBank basepairs</th><td>{{ gbBasepairs }}</td></tr>
                    <tr><th>Genome size (bp)</th><td>{{ size }}</td></tr>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
