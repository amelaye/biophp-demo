{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'file' %}
{% set page_title = 'doc.parsePrfRecord.page_title'|trans %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.common.parsed_record'|trans }}</summary>
            <div class="card-body">
                    <table class="table table-sm">
                        <tr><th>{{ 'doc.parsePrfRecord.entry_code'|trans }}</th><td>{{ entryCode }}</td></tr>
                        <tr><th>{{ 'doc.common.entry_name'|trans }}</th><td>{{ entryName }}</td></tr>
                        <tr><th>{{ 'doc.parsePrfRecord.source_organism'|trans }}</th><td>{{ source }}</td></tr>
                        <tr><th>{{ 'doc.common.common_name'|trans }}</th><td>{{ commonName }}</td></tr>
                        <tr><th>{{ 'doc.parsePrfRecord.taxonomy'|trans }}</th><td>{{ macros.render_value(taxonomy) }}</td></tr>
                        <tr><th>{{ 'doc.common.journal'|trans }}</th><td>{{ journal }}</td></tr>
                        <tr><th>{{ 'doc.parsePrfRecord.authors'|trans }}</th><td>{{ macros.render_value(authors) }}</td></tr>
                        <tr><th>{{ 'doc.common.title'|trans }}</th><td>{{ recordTitle }}</td></tr>
                        <tr><th>{{ 'doc.common.keywords'|trans }}</th><td>{{ macros.render_value(keywords) }}</td></tr>
                        <tr>
                            <th>{{ 'doc.parsePrfRecord.sequence'|trans }}</th>
                            <td><pre class="mb-0" style="white-space: pre-wrap; word-break: break-all;">{{ sequence }}</pre></td>
                        </tr>
                    </table>
            </div>
        </details>
    </div>
{% endblock %}
