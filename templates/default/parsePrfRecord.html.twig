{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as macros %}
{% block body %}
    <div class="container">
        <h1>PRF: Protein Research Foundation record</h1>
        <br>
        <h4>Sample code : </h4>
        <br>
        {{ code | raw }}
        <br>
        <h4>Result :</h4>
        <div class="card border-info mb-3" style="font-size:0.9em">
            <div class="card-header">Results of your request</div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr><th>Entry code</th><td>{{ entryCode }}</td></tr>
                    <tr><th>Entry name</th><td>{{ entryName }}</td></tr>
                    <tr><th>Source organism</th><td>{{ source }}</td></tr>
                    <tr><th>Common name</th><td>{{ commonName }}</td></tr>
                    <tr><th>Taxonomy</th><td>{{ macros.render_value(taxonomy) }}</td></tr>
                    <tr><th>Journal</th><td>{{ journal }}</td></tr>
                    <tr><th>Authors</th><td>{{ macros.render_value(authors) }}</td></tr>
                    <tr><th>Title</th><td>{{ recordTitle }}</td></tr>
                    <tr><th>Keywords</th><td>{{ macros.render_value(keywords) }}</td></tr>
                    <tr>
                        <th>Sequence</th>
                        <td><pre class="mb-0" style="white-space: pre-wrap; word-break: break-all;">{{ sequence }}</pre></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
