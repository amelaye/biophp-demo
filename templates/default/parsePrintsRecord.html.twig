{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'file' %}
{% set page_title = 'PRINTS: protein fingerprint record' %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">Results of your request</div>
        <div class="card-body">
            <table class="table table-sm">
                <tr><th>Entry name</th><td>{{ entryName }}</td></tr>
                <tr><th>Entry type</th><td>{{ entryType }}</td></tr>
                <tr><th>Create date</th><td>{{ createDate }}</td></tr>
                <tr><th>Update date</th><td>{{ updDate }}</td></tr>
                <tr><th>Description</th><td>{{ description }}</td></tr>
            </table>
        </div>
    </div>
{% endblock %}
