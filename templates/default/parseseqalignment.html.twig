{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'align' %}
{% set page_title = 'doc.parseseqalignment.page_title'|trans %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.common.parsed_sequences'|trans }}</summary>
            <div class="card-body">
                    {{ macros.sequence_set_table(sequences) }}
            </div>
        </details>
    </div>
{% endblock %}
