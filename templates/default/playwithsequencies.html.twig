{% block extra %}
    <section class="bp-step">
        <div class="bp-step__head">
            <span class="bp-step__num">3</span>
            <div>
                <h2 class="bp-step__title">{{ 'doc.playwithsequencies.new_in_biophp_1_1_the_sequence'|trans }}</h2>
            </div>
            <span></span>
        </div>
        <div class="bp-result">
            <br>

            <div class="card border-success mb-3" style="font-size:0.9em">
                <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
                <div class="card-body">
                    <p>{{ 'doc.playwithsequencies.dna_complement_computed_by_the_dnasequence_value'|trans }}</p>
                    {{ macros.render_value(voComplement) }}
                </div>
            </div>

            <div class="card border-success mb-3" style="font-size:0.9em">
                <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
                <div class="card-body">
                    <p>{{ 'doc.playwithsequencies.reverse_complement_the_strand_facing_this_one'|trans }}</p>
                    {{ macros.render_value(voReverseComplement) }}
                </div>
            </div>

            <div class="card border-success mb-3" style="font-size:0.9em">
                <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
                <div class="card-body">
                    <p>{{ 'doc.playwithsequencies.gc_content'|trans }}</p>
                    {{ macros.render_value(voGcContent) }}
                </div>
            </div>

            <div class="card border-success mb-3" style="font-size:0.9em">
                <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
                <div class="card-body">
                    <p>{{ 'doc.playwithsequencies.transcribed_to_rna_thymine_becomes_uracil'|trans }}</p>
                    {{ macros.render_value(voToRna) }}
                </div>
            </div>

            <div class="card border-success mb-3" style="font-size:0.9em">
                <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
                <div class="card-body">
                    <p>{{ 'doc.playwithsequencies.substring_of_the_sequence_still_a_validated'|trans }}</p>
                    {{ macros.render_value(voSubSequence) }}
                </div>
            </div>

            <div class="card border-success mb-3" style="font-size:0.9em">
                <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
                <div class="card-body">
                    <p>{{ 'doc.playwithsequencies.two_value_objects_built_from_the_same'|trans }}</p>
                    {{ macros.render_value(voEquals) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
