{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'shuffle' %}
{% set page_title = 'doc.playwithsequencies.page_title'|trans %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.dna_complement'|trans }}</p>
            {{ macros.render_value(complement) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.returns_the_expansion_of_a_nucleic_acid'|trans }}</p>
            {{ macros.render_value(expandNa) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.shows_halfstring_for_pattern_gattag'|trans }}</p>
            {{ macros.render_value(halfStr) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.computes_the_molecular_weight_of_a_particular'|trans }}</p>
            {{ macros.render_value(molWt) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.creates_a_new_sequence_object_with_a'|trans }}</p>
            {{ macros.render_value(coupe) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.array_where_each_key_is_a_substring'|trans }}</p>
            {{ macros.render_value(patpos) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.similar_to_patpos_except_that_this_allows'|trans }}</p>
            {{ macros.render_value(patposo) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.returns_the_frequency_of_a_given_symbol'|trans }}</p>
            {{ macros.render_value(symfreq) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.returns_the_3rd_codon_in_a_sequence'|trans }}</p>
            {{ macros.render_value(codon) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.translates_a_particular_dna_sequence_into_its'|trans }}</p>
            {{ macros.render_value(translate) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.translates_an_amino_acid_sequence_gavlifywkrh_into'|trans }}</p>
            {{ macros.render_value(charge) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.returns_a_string_of_symbols_from_an'|trans }}</p>
            {{ macros.render_value(chemicalGroup) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.playwithsequencies.returns_a_two_dimensional_array_containing_palindromic'|trans }}</p>
            {{ macros.render_value(testPalindrome1) }}
        </div>
