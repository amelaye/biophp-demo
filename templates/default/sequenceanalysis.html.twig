{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'dna' %}
{% set page_title = 'Simple sequence analysis' %}

{% block intro %}
    <p>This code finds mirrors into a sequence string. It takes as parameter one start and one end.</p>
{% endblock %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">Results of your request</div>
        <div class="card-body">
            {{ macros.render_value(mirrors) }}
        </div>
    </div>
{% endblock %}
