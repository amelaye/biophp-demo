{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as macros %}
{% block body %}
    <div class="container">
        <h1>PIR: Protein Information Resource record</h1>
        <br>
        <h4>Sample code : </h4>
        <br>
        {{ code | raw }}
        <br>
        <h4>Result :</h4>
        <div class="card border-info mb-3" style="font-size:0.9em">
            <div class="card-header">Results of your request</div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr><th>Entry name</th><td>{{ entryName }}</td></tr>
                    <tr><th>Entry type</th><td>{{ entryType }}</td></tr>
                    <tr><th>Title</th><td>{{ recordTitle }}</td></tr>
                    <tr><th>Accessions</th><td>{{ macros.render_value(accessions) }}</td></tr>
                    <tr><th>Organism</th><td>{{ organism }}</td></tr>
                    <tr><th>Species</th><td>{{ species }}</td></tr>
                    <tr><th>Create date</th><td>{{ createDate }}</td></tr>
                    <tr><th>Length</th><td>{{ length }}</td></tr>
                    <tr><th>Mol. weight</th><td>{{ molwt }}</td></tr>
                    <tr><th>Checksum</th><td>{{ checksum }}</td></tr>
                    <tr><th>Keywords</th><td>{{ macros.render_value(keywords) }}</td></tr>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
