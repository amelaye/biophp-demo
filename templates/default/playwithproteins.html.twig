{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'protein' %}
{% set page_title = 'doc.playwithproteins.page_title'|trans %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.playwithproteins.returns_the_length_of_a_protein'|trans }}</summary>
            <div class="card-body">
                    {{ macros.render_value(length) }}
            </div>
        </details>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.playwithproteins.returns_the_molweight_of_a_protein'|trans }}</summary>
            <div class="card-body">
                    {{ macros.render_value(molwt) }}
            </div>
        </details>
    </div>
{% endblock %}

{% block extra %}
    <section class="bp-step">
        <div class="bp-step__head">
            <span class="bp-step__num">3</span>
            <div>
                <h2 class="bp-step__title">{{ 'doc.playwithproteins.new_in_biophp_1_1_the_protein'|trans }}</h2>
            </div>
            <span></span>
        </div>
        <div class="bp-result">
            <br>

    <div class="card border-success mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.playwithproteins.length_computed_by_the_aminoacidsequence_value_object'|trans }}</summary>
            <div class="card-body">
                            {{ macros.render_value(voLength) }}
            </div>
        </details>
    </div>

    <div class="card border-success mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.playwithproteins.does_the_chain_hold_a_stop_codon'|trans }}</summary>
            <div class="card-body">
                            {{ macros.render_value(voHasStop) }}
            </div>
        </details>
    </div>

    <div class="card border-success mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.playwithproteins.does_the_chain_hold_an_unknown_residue'|trans }}</summary>
            <div class="card-body">
                            {{ macros.render_value(voHasUnknownResidue) }}
            </div>
        </details>
    </div>

    <div class="card border-success mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.playwithproteins.number_of_x_residues_in_the_chain'|trans }}</summary>
            <div class="card-body">
                            {{ macros.render_value(voCountX) }}
            </div>
        </details>
    </div>
        </div>
    </section>
{% endblock %}
