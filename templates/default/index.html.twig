{% extends 'base.html.twig' %}

{% block title %}Amelaye's BioPHP demo{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/biophp-theme.css') }}">
    <link rel="stylesheet" href="{{ asset('css/biophp.css') }}">
{% endblock %}

{% macro icon(name, class) %}
    <svg class="{{ class|default('') }}" aria-hidden="true" focusable="false"><use href="#bp-i-{{ name }}"></use></svg>
{% endmacro %}

{% macro row(item) %}
    {% import _self as ui %}
    <a class="bp-row" href="{{ url(item.route, item.params|default({})) }}">
        <span class="bp-tile bp-tile--sm">{{ ui.icon(item.icon) }}</span>
        <span class="bp-row__text">
            <span class="bp-row__title">{{ item.title|trans }}</span>
            {% if item.desc is defined and item.desc %}
                <span class="bp-row__desc">{{ item.desc|trans }}</span>
            {% endif %}
        </span>
        {% if item.badge is defined and item.badge %}
            <span class="bp-badge">{{ item.badge }}</span>
        {% else %}
            <span></span>
        {% endif %}
        {{ ui.icon('chevron', 'bp-row__chevron') }}
    </a>
{% endmacro %}

{% block body %}
{% import _self as ui %}

<div class="bp-page">
    <div class="bp-page__bg"></div>

    <div class="bp-shell">

        {# ------------------------------------------- sélecteur de langue #}
        {# seule page à le porter : le choix est mémorisé en session et suivi
           ensuite sur tout le site (App\EventSubscriber\LocaleSubscriber) #}
        <nav class="bp-locale" aria-label="{{ 'nav.language'|trans }}">
            {% for locale in bp_locales %}
                <a class="bp-locale__link{{ app.request.locale == locale ? ' is-active' : '' }}"
                   href="{{ url('index', {'_locale': locale}) }}"
                   lang="{{ locale }}"
                   {{ app.request.locale == locale ? 'aria-current="true"' : '' }}>{{ locale|upper }}</a>
            {% endfor %}
        </nav>

        {# ------------------------------------------------------------ hero #}
        <header class="bp-hero">
            <img class="bp-hero__logo" src="{{ asset('img/biophp-logo-hero.png') }}" alt="BioPHP" width="880" height="631">
            <h1 class="bp-hero__title">Amelaye's BioPHP demo</h1>
            <p class="bp-hero__tagline">{{ 'index.tagline'|trans|nl2br }}</p>
        </header>

        {# ----------------------------------------------------------- cards #}
        <div class="bp-grid">

            <section class="bp-card" id="code-samples">
                <div class="bp-card__head">
                    <span class="bp-tile bp-tile--lg">{{ ui.icon('code') }}</span>
                    <div>
                        <h2 class="bp-card__title">{{ 'nav.code_samples'|trans }}</h2>
                        <p class="bp-card__lead">{{ 'index.code_samples.lead'|trans }}</p>
                    </div>
                </div>
                <div class="bp-card__body">
                    {% for group in bp_samples %}
                        <h3 class="bp-group">{{ group.group|trans }}</h3>
                        {% for item in group.items %}{{ ui.row(item) }}{% endfor %}
                    {% endfor %}
                </div>
                <div class="bp-card__foot">
                    <a class="bp-btn" href="#code-samples">{{ 'index.code_samples.cta'|trans }} {{ ui.icon('chevron') }}</a>
                </div>
            </section>

            <section class="bp-card bp-card--blue" id="biotools">
                <div class="bp-card__head">
                    <span class="bp-tile bp-tile--lg">{{ ui.icon('briefcase') }}</span>
                    <div>
                        <h2 class="bp-card__title">{{ 'nav.biotools'|trans }}</h2>
                        <p class="bp-card__lead">{{ 'index.biotools.lead'|trans }}</p>
                    </div>
                </div>
                <div class="bp-card__body">
                    {% for item in bp_tools %}{{ ui.row(item) }}{% endfor %}
                </div>
                <div class="bp-card__foot">
                    <a class="bp-btn" href="#biotools">{{ 'index.biotools.cta'|trans }} {{ ui.icon('chevron') }}</a>
                </div>
            </section>

        </div>

        {# ---------------------------------------------------------- footer #}
        <footer class="bp-footer">
            <img class="bp-footer__mark" src="{{ asset('img/biophp-mark.png') }}" alt="" width="256" height="179">
            <span><span class="bp-footer__name">BioPHP</span> &ndash; {{ 'index.footer'|trans }}</span>
        </footer>

    </div>
</div>

{{ include('partials/icons.html.twig') }}
{% endblock %}
