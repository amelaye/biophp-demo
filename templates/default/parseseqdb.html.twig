{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'database' %}
{% set page_title = 'Insert a sequence into a database, and loads a array of objects' %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">Results of your request</div>
        <div class="card-body">
            {{ macros.sequence_details(sequence) }}
        </div>
    </div>

    <div class="card border-success mb-3" style="font-size:0.9em">
        <div class="card-header">Results of your request</div>
        <div class="card-body">
            <p>New in biophp 1.1: GC content, computed by wrapping the record into a DnaSequence value object</p>
            {{ macros.render_value(gcContent) }}
        </div>
    </div>
{% endblock %}
