{% extends 'layout/sample.html.twig' %}
{% import 'partials/vcf_table.html.twig' as variants_ui %}

{% set page_icon  = 'file' %}
{% set page_title = 'doc.variantsWriteVcf.page_title'|trans %}

{% block intro %}<p>{{ 'doc.variantsWriteVcf.intro'|trans }}</p>{% endblock %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.variantsWriteVcf.written'|trans }}</summary>
            <div class="card-body">
                <pre class="mb-0" style="white-space: pre; overflow-x: auto;">{{ vcf }}</pre>
            </div>
        </details>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.variantsWriteVcf.read_back'|trans }}</summary>
            <div class="card-body">
                {{ variants_ui.table(readBack) }}
                <p class="mb-0">{{ (identical ? 'doc.variantsWriteVcf.identical' : 'doc.variantsWriteVcf.different')|trans }}</p>
            </div>
        </details>
    </div>
{% endblock %}
