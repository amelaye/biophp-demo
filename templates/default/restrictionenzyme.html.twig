{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'scissors' %}
{% set page_title = 'doc.restrictionenzyme.page_title'|trans %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.restrictionenzyme.gets_the_enzyme_aati_properties'|trans }}</summary>
            <div class="card-body">
                    <table class="table table-sm">
                        <tr><th>{{ 'doc.restrictionenzyme.name'|trans }}</th><td>{{ enzymeParsed.getName() }}</td></tr>
                        <tr><th>{{ 'doc.restrictionenzyme.pattern'|trans }}</th><td>{{ enzymeParsed.getPattern() }}</td></tr>
                        <tr><th>{{ 'doc.restrictionenzyme.cut_position'|trans }}</th><td>{{ enzymeParsed.getCutpos() }}</td></tr>
                        <tr><th>{{ 'doc.common.length'|trans }}</th><td>{{ enzymeParsed.getLength() }}</td></tr>
                    </table>
            </div>
        </details>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.restrictionenzyme.cuts_a_dna_sequence_into_fragments_using'|trans }}</summary>
            <div class="card-body">
                    {{ macros.render_value(cutseq) }}
            </div>
        </details>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.restrictionenzyme.cuts_a_dna_sequence_into_fragments_using_2'|trans }}</summary>
            <div class="card-body">
                    {{ macros.render_value(cutseq2) }}
            </div>
        </details>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.restrictionenzyme.searching_endonucleases'|trans }} <br>
                {{ 'doc.restrictionenzyme.fetch_pattern_only'|trans }}</summary>
            <div class="card-body">
                    {{ macros.render_value(list) }}
            </div>
        </details>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.restrictionenzyme.fetch_pattern_aggcct_cutpos_3'|trans }}</summary>
            <div class="card-body">
                    {{ macros.render_value(list2) }}
            </div>
        </details>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.restrictionenzyme.fetch_cutpos_3_only'|trans }}</summary>
            <div class="card-body">
                    {{ macros.render_value(list3) }}
            </div>
        </details>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.restrictionenzyme.fetch_length_6_only'|trans }}</summary>
            <div class="card-body">
                    {{ macros.render_value(list4) }}
            </div>
        </details>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.restrictionenzyme.fetch_length_6_and_cutpos_3_no'|trans }}</summary>
            <div class="card-body">
                    {{ macros.render_value(list5) }}
            </div>
        </details>
    </div>
{% endblock %}
