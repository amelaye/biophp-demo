{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'scissors' %}
{% set page_title = 'doc.restrictionenzyme.page_title'|trans %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.restrictionenzyme.gets_the_enzyme_aati_properties'|trans }}</p>
            <table class="table table-sm">
                <tr><th>{{ 'doc.restrictionenzyme.name'|trans }}</th><td>{{ enzymeParsed.getName() }}</td></tr>
                <tr><th>{{ 'doc.restrictionenzyme.pattern'|trans }}</th><td>{{ enzymeParsed.getPattern() }}</td></tr>
                <tr><th>{{ 'doc.restrictionenzyme.cut_position'|trans }}</th><td>{{ enzymeParsed.getCutpos() }}</td></tr>
                <tr><th>{{ 'doc.common.length'|trans }}</th><td>{{ enzymeParsed.getLength() }}</td></tr>
            </table>
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.restrictionenzyme.cuts_a_dna_sequence_into_fragments_using'|trans }}</p>
            {{ macros.render_value(cutseq) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.restrictionenzyme.cuts_a_dna_sequence_into_fragments_using_2'|trans }}</p>
            {{ macros.render_value(cutseq2) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>
                {{ 'doc.restrictionenzyme.searching_endonucleases'|trans }} <br>
                {{ 'doc.restrictionenzyme.fetch_pattern_only'|trans }}
            </p>
            {{ macros.render_value(list) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.restrictionenzyme.fetch_pattern_aggcct_cutpos_3'|trans }}</p>
            {{ macros.render_value(list2) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.restrictionenzyme.fetch_cutpos_3_only'|trans }}</p>
            {{ macros.render_value(list3) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.restrictionenzyme.fetch_length_6_only'|trans }}</p>
            {{ macros.render_value(list4) }}
        </div>
    </div>

    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <p>{{ 'doc.restrictionenzyme.fetch_length_6_and_cutpos_3_no'|trans }}</p>
            {{ macros.render_value(list5) }}
        </div>
    </div>
{% endblock %}
