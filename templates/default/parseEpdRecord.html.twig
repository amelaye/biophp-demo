{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'file' %}
{% set page_title = 'doc.parseEpdRecord.page_title'|trans %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.common.parsed_record'|trans }}</summary>
            <div class="card-body">
                    <table class="table table-sm">
                        <tr><th>{{ 'doc.common.entry_name'|trans }}</th><td>{{ entryName }}</td></tr>
                        <tr><th>{{ 'doc.parseEpdRecord.data_class'|trans }}</th><td>{{ dataClass }}</td></tr>
                        <tr><th>{{ 'doc.parseEpdRecord.taxonomic_division'|trans }}</th><td>{{ taxDiv }}</td></tr>
                        <tr><th>{{ 'doc.common.accessions'|trans }}</th><td>{{ macros.render_value(accessions) }}</td></tr>
                        <tr><th>{{ 'doc.common.create_date'|trans }}</th><td>{{ createDate }}</td></tr>
                        <tr><th>{{ 'doc.common.description'|trans }}</th><td>{{ description }}</td></tr>
                        <tr><th>{{ 'doc.parseEpdRecord.comments'|trans }}</th><td>{{ comments }}</td></tr>
                    </table>
            </div>
        </details>
    </div>
{% endblock %}
