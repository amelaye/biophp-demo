{% extends 'layout/sample.html.twig' %}
{% import 'partials/phylo_tree.html.twig' as phylo %}

{% set page_icon  = 'chart' %}
{% set page_title = 'doc.phylogeneticsNeighborJoining.page_title'|trans %}

{% macro comparison(matrix, distances) %}
    <table class="table table-sm table-bordered">
        <thead>
            <tr><th>{{ 'doc.phylogeneticsNeighborJoining.pair'|trans }}</th><th>{{ 'doc.phylogeneticsNeighborJoining.matrix'|trans }}</th><th>{{ 'doc.phylogeneticsNeighborJoining.on_the_tree'|trans }}</th></tr>
        </thead>
        <tbody>
        {% for row, first in matrix.labels %}
            {% for column, second in matrix.labels %}
                {% if column > row %}
                    {% set expected = matrix.getDistance(row, column) %}
                    {% set found = distances[first][second]|round(3) %}
                    <tr>
                        <td>{{ first }} – {{ second }}</td>
                        <td>{{ expected }}</td>
                        <td>{% if found == expected %}{{ found }} &#10003;{% else %}<strong>{{ found }}</strong> &#10007;{% endif %}</td>
                    </tr>
                {% endif %}
            {% endfor %}
        {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{% block intro %}<p>{{ 'doc.phylogeneticsNeighborJoining.intro'|trans }}</p>{% endblock %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <details class="bp-acc" open>
            <summary class="card-header">{{ 'doc.phylogenetics.distance_matrix'|trans }}</summary>
            <div class="card-body bp-tablewrap">{{ phylo.matrix(matrix) }}</div>
        </details>
    </div>

    {% for method, data in {
        'Neighbor-Joining': {'tree': njTree, 'distances': njDistances, 'verdict': 'doc.phylogeneticsNeighborJoining.nj_verdict'},
        'UPGMA': {'tree': upgmaTree, 'distances': upgmaDistances, 'verdict': 'doc.phylogeneticsNeighborJoining.upgma_verdict'}
    } %}
        <div class="card border-info mb-3" style="font-size:0.9em">
            <details class="bp-acc" open>
                <summary class="card-header">{{ method }}</summary>
                <div class="card-body">
                    <pre>{{ phylo.draw(data.tree) }}</pre>
                    <p><code style="word-break: break-all;">{{ data.tree.toNewick() }}</code></p>
                    {{ _self.comparison(matrix, data.distances) }}
                    <p class="mb-0">{{ data.verdict|trans }}</p>
                </div>
            </details>
        </div>
    {% endfor %}
{% endblock %}
