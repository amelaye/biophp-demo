{% extends 'layout/sample.html.twig' %}

{% set page_icon  = 'file' %}
{% set page_title = 'doc.cloningExport.page_title'|trans %}

{% block intro %}<p>{{ 'doc.cloningExport.intro'|trans }}</p>{% endblock %}

{% block result %}
    {% for label, content in {'GenBank': genbank, 'GFF3': gff, 'BED': bed} %}
        <div class="card border-info mb-3" style="font-size:0.9em">
            <details class="bp-acc" {% if not loop.first %}open{% endif %}>
                <summary class="card-header">{{ label }}</summary>
                <div class="card-body">
                    <pre class="mb-0" style="white-space: pre; overflow-x: auto;">{{ content }}</pre>
                </div>
            </details>
        </div>
    {% endfor %}
{% endblock %}
