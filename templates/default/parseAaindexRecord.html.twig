{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'file' %}
{% set page_title = 'doc.parseAaindexRecord.page_title'|trans %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">{{ 'step.results_of_request'|trans }}</div>
        <div class="card-body">
            <table class="table table-sm">
                <tr><th>{{ 'doc.common.accession'|trans }}</th><td>{{ accession }}</td></tr>
                <tr><th>{{ 'doc.common.description'|trans }}</th><td>{{ description }}</td></tr>
                <tr><th>{{ 'doc.parseAaindexRecord.author'|trans }}</th><td>{{ author }}</td></tr>
                <tr><th>{{ 'doc.common.title'|trans }}</th><td>{{ recordTitle }}</td></tr>
                <tr><th>{{ 'doc.common.journal'|trans }}</th><td>{{ journal }}</td></tr>
                <tr><th>{{ 'doc.parseAaindexRecord.literature_refs'|trans }}</th><td>{{ macros.render_value(litRefs) }}</td></tr>
            </table>
        </div>
    </div>
{% endblock %}
