{% extends 'layout/sample.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set page_icon  = 'file' %}
{% set page_title = 'AAindex: amino acid index record' %}

{% block result %}
    <div class="card border-info mb-3" style="font-size:0.9em">
        <div class="card-header">Results of your request</div>
        <div class="card-body">
            <table class="table table-sm">
                <tr><th>Accession</th><td>{{ accession }}</td></tr>
                <tr><th>Description</th><td>{{ description }}</td></tr>
                <tr><th>Author</th><td>{{ author }}</td></tr>
                <tr><th>Title</th><td>{{ recordTitle }}</td></tr>
                <tr><th>Journal</th><td>{{ journal }}</td></tr>
                <tr><th>Literature refs</th><td>{{ macros.render_value(litRefs) }}</td></tr>
            </table>
        </div>
    </div>
{% endblock %}
